&Тест
Процедура ЗаменитьЕслиЗначение() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Заменено   = Карта.ЗаменитьЕслиЗначение("а", 1, 10);
	НеЗаменено = Карта.ЗаменитьЕслиЗначение("б", 1, 20);
	Отсутствует = Карта.ЗаменитьЕслиЗначение("г", 1, 4);

	// Тогда

	Ожидаем.Что(Заменено).ЭтоИстина();
	Ожидаем.Что(НеЗаменено).ЭтоЛожь();
	Ожидаем.Что(Отсутствует).ЭтоЛожь();
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(10);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("б", 0)).Равно(2);
	Ожидаем.Что(Карта.СодержитКлюч("г")).ЭтоЛожь();

КонецПроцедуры

