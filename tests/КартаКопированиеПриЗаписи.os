&Тест
Процедура ПреставлениеПереопределяется() Экспорт

	// Дано

	Карта = Новый КартаКопированиеПриЗаписи();
	Карта.Вставить("а", Карта);

	// Когда

	Результат = Строка(Карта);

	// Тогда

	Ожидаем.Что(Результат).Равно("{а=(Эта карта)}");

КонецПроцедуры

Функция ДолгоВычислитьЗначение(Ключ) Экспорт

	ВызововФункции = ВызововФункции + 1;

	Приостановить(50);

	Возврат 42;

КонецФункции

Функция УвеличитьСчетчикСтоРаз(Карта) Экспорт

	Для Счетчик = 1 По 100 Цикл // BSLLS:UnusedLocalVariable-off
		Карта.Слить("Счетчик", 1, "(Было, Стало) -> Было + Стало");
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДействиеДляКаждого(Ключ, Значение) Экспорт

	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;

	Ожидаем.Что(Ключ).ИмеетТип("Строка");
	Ожидаем.Что(Значение).ИмеетТип("Число");

КонецПроцедуры

Функция КартаФикстура()

	Карта = Новый КартаКопированиеПриЗаписи();
	Карта.Вставить("а", 1);
	Карта.Вставить("б", 2);
	Карта.Вставить("в", 3);

	Возврат Карта;

КонецФункции
