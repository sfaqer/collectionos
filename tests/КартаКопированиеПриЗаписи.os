&Тест
Процедура ЗаменитьВсеНеопределеноНеИзменяетКарту() Экспорт

	// Дано

	Карта = КартаФикстура();

	Параметры = Новый Массив;
	Параметры.Добавить("(Ключ, Значение) -> ?(Ключ = ""в"", Неопределено, Значение + 10)");

	// Тогда

	Ожидаем.Что(Карта)
		.Метод("ЗаменитьВсе", Параметры)
		.ВыбрасываетИсключение("Неопределено не может быть в качестве ключа или значения карты");

	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(1);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("в", 0)).Равно(3);

