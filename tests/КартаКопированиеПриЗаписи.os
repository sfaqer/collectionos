#Использовать asserts

#Использовать ".."
#Использовать "./ТестМодуль"

Перем ДляКаждогоВыполнилсяРаз; // Количество раз которое выполнился метод ДляКаждого
Перем ВызововФункции;          // Количество вызовов функции вычисления значения из фоновых заданий

&Тест
Процедура КартаКопированиеПриЗаписиСоздается() Экспорт

	// Когда

	Результат = Новый КартаКопированиеПриЗаписи();

	// Тогда

	Ожидаем.Что(Результат).ИмеетТип("КартаКопированиеПриЗаписи");
	Ожидаем.Что(Результат.Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СоздаетсяИзКарты() Экспорт

	// Дано

	Исходная = Новый КартаСоответствие();
	Исходная.Вставить("а", 1);

	// Когда

	Результат = Новый КартаКопированиеПриЗаписи(Исходная);
	Исходная.Вставить("б", 2);

	// Тогда

	Ожидаем.Что(Результат.Количество()).Равно(1);
	Ожидаем.Что(Результат.ПолучитьИлиУмолчание("а", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура СодержитКлючИЗначение() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Тогда

	Ожидаем.Что(Карта.СодержитКлюч("а")).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитКлюч("г")).ЭтоЛожь();
	Ожидаем.Что(Карта.СодержитЗначение(2)).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитЗначение(4)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДляКаждого() Экспорт

	// Дано

	ДляКаждогоВыполнилсяРаз = 0;

	// Когда

	КартаФикстура().ДляКаждого(Новый Действие(ЭтотОбъект, "ДействиеДляКаждого"));

	// Тогда

	Ожидаем.Что(ДляКаждогоВыполнилсяРаз).Равно(3);

КонецПроцедуры

&Тест
Процедура ДляКаждогоДопускаетИзменениеКарты() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Карта.ДляКаждого("(Ключ, Значение) -> Карта.Вставить(Ключ + Ключ, Значение)", Новый Структура("Карта", Карта));

	// Тогда

	Ожидаем.Что(Карта.Количество()).Равно(6);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("аа", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура Получить() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Тогда

	Ожидаем.Что(Карта.Получить("б").Получить()).Равно(2);
	Ожидаем.Что(Карта.Получить("г").Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("г", 4)).Равно(4);

КонецПроцедуры

&Тест
Процедура ПредставленияОтражаютСнимокНаМоментПолучения() Экспорт

	// Дано

	Карта = КартаФикстура();

	Ключи          = Карта.Ключи();
	Значения       = Карта.Значения();
	КлючиИЗначения = Карта.КлючиИЗначения();
	Итератор       = Ключи.Итератор();

	// Когда

	Карта.Вставить("г", 4);
	Карта.Удалить("а");

	// Тогда

	Ожидаем.Что(Ключи.Количество()).Равно(3);
	Ожидаем.Что(Ключи.Содержит("а")).ЭтоИстина();
	Ожидаем.Что(Ключи.Содержит("г")).ЭтоЛожь();
	Ожидаем.Что(Значения.Содержит(4)).ЭтоЛожь();
	Ожидаем.Что(КлючиИЗначения.Количество()).Равно(3);
	Ожидаем.Что(Итератор.ЕстьСледующий()).ЭтоИстина();
	Итератор.Следующий();

	Ожидаем.Что(Карта.Ключи().Содержит("г")).ЭтоИстина();
	Ожидаем.Что(Карта.Ключи().Содержит("а")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура Очистить() Экспорт

	// Дано

	Карта = КартаФикстура();
	Ключи = Карта.Ключи();

	// Когда

	Карта.Очистить();

	// Тогда

	Ожидаем.Что(Карта.Пусто()).ЭтоИстина();
	Ожидаем.Что(Ключи.Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура Вставить() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Прошлое = Карта.Вставить("а", 10);
	Новое   = Карта.Вставить("г", 4);

	// Тогда

	Ожидаем.Что(Прошлое.Получить()).Равно(1);
	Ожидаем.Что(Новое.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(10);
	Ожидаем.Что(Карта.Количество()).Равно(4);

КонецПроцедуры

&Тест
Процедура ВставитьНеопределеноВызываетИсключение() Экспорт

	// Дано

	Карта = КартаФикстура();

	Параметры = Новый Массив;
	Параметры.Добавить("а");
	Параметры.Добавить(Неопределено);

	// Тогда

	Ожидаем.Что(Карта)
		.Метод("Вставить", Параметры)
		.ВыбрасываетИсключение("Неопределено не может быть в качестве ключа или значения карты");

	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(1);

КонецПроцедуры

&Тест
Процедура ВставитьВсе() Экспорт

	// Дано

	Карта = КартаФикстура();

	Вставляемые = Новый КартаСоответствие();
	Вставляемые.Вставить("а", 10);
	Вставляемые.Вставить("г", 4);

	// Когда

	Карта.ВставитьВсе(Вставляемые);

	// Тогда

	Ожидаем.Что(Карта.Количество()).Равно(4);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(10);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("г", 0)).Равно(4);

КонецПроцедуры

&Тест
Процедура ВставитьЕслиОтсутствует() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Существующее = Карта.ВставитьЕслиОтсутствует("а", 10);
	Отсутствующее = Карта.ВставитьЕслиОтсутствует("г", 4);

	// Тогда

	Ожидаем.Что(Существующее.Получить()).Равно(1);
	Ожидаем.Что(Отсутствующее.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(1);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("г", 0)).Равно(4);

КонецПроцедуры

&Тест
Процедура ВычислитьБезусловно() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Обновлено = Карта.ВычислитьБезусловно("а", "(Ключ, Значение) -> Значение.Получить() + 10");
	Вставлено = Карта.ВычислитьБезусловно("г", "(Ключ, Значение) -> ?(Значение.Пустой(), 4, 0)");
	Удалено   = Карта.ВычислитьБезусловно("б", "(Ключ, Значение) -> Неопределено");

	// Тогда

	Ожидаем.Что(Обновлено.Получить()).Равно(11);
	Ожидаем.Что(Вставлено.Получить()).Равно(4);
	Ожидаем.Что(Удалено.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитКлюч("б")).ЭтоЛожь();
	Ожидаем.Что(Карта.Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура ВычислитьБезусловноИзменениеВнутриФункцииВызываетИсключение() Экспорт

	// Дано

	Карта = КартаФикстура();

	Параметры = Новый Массив;
	Параметры.Добавить("а");
	Параметры.Добавить("(Ключ, Значение) -> { Карта.Удалить(""б""); Возврат 10; }");
	Параметры.Добавить(Новый Структура("Карта", Карта));

	// Тогда

	Ожидаем.Что(Карта)
		.Метод("ВычислитьБезусловно", Параметры)
		.ВыбрасываетИсключение("Коллекция была изменена в процессе обхода");

	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(1);
	Ожидаем.Что(Карта.СодержитКлюч("б")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВычислитьЕслиОтсутствует() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Существующее  = Карта.ВычислитьЕслиОтсутствует("а", "Ключ -> { ВызватьИсключение ""Не должна вызываться""; Возврат Неопределено; }");
	Вычисленное   = Карта.ВычислитьЕслиОтсутствует("гг", "Ключ -> СтрДлина(Ключ)");
	НеВычисленное = Карта.ВычислитьЕслиОтсутствует("д", "Ключ -> Неопределено");

	// Тогда

	Ожидаем.Что(Существующее.Получить()).Равно(1);
	Ожидаем.Что(Вычисленное.Получить()).Равно(2);
	Ожидаем.Что(НеВычисленное.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитКлюч("д")).ЭтоЛожь();
	Ожидаем.Что(Карта.Количество()).Равно(4);

КонецПроцедуры

&Тест
Процедура ВычислитьЕслиОтсутствуетИзНесколькихПотоковВычисляетОдинРаз() Экспорт

	// Дано

	ВызововФункции = 0;

	Карта = Новый КартаКопированиеПриЗаписи();

	// Когда

	ТестМодуль.ВыполнитьВПятьПотоков(
		Карта,
		"ВычислитьЕслиОтсутствует",
		"Ключ",
		Новый Действие(ЭтотОбъект, "ДолгоВычислитьЗначение")
	);

	// Тогда

	Ожидаем.Что(ВызововФункции).Равно(1);
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("Ключ", 0)).Равно(42);

КонецПроцедуры

&Тест
Процедура ВычислитьЕслиПрисутствует() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Обновлено     = Карта.ВычислитьЕслиПрисутствует("а", "(Ключ, Значение) -> Значение + 10");
	Отсутствующий = Карта.ВычислитьЕслиПрисутствует("г", "(Ключ, Значение) -> 4");
	Удалено       = Карта.ВычислитьЕслиПрисутствует("б", "(Ключ, Значение) -> Неопределено");

	// Тогда

	Ожидаем.Что(Обновлено.Получить()).Равно(11);
	Ожидаем.Что(Отсутствующий.Пустой()).ЭтоИстина();
	Ожидаем.Что(Удалено.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитКлюч("г")).ЭтоЛожь();
	Ожидаем.Что(Карта.СодержитКлюч("б")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура Слить() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Слито     = Карта.Слить("а", 10, "(Было, Стало) -> Было + Стало");
	Вставлено = Карта.Слить("г", 4, "(Было, Стало) -> { ВызватьИсключение ""Не должна вызываться""; Возврат Неопределено; }");
	Удалено   = Карта.Слить("б", 2, "(Было, Стало) -> Неопределено");

	// Тогда

	Ожидаем.Что(Слито.Получить()).Равно(11);
	Ожидаем.Что(Вставлено.Получить()).Равно(4);
	Ожидаем.Что(Удалено.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.СодержитКлюч("б")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СлитьИзНесколькихПотоковНеТеряетИзменений() Экспорт

	// Дано

	Карта = Новый КартаКопированиеПриЗаписи();

	// Когда

	ТестМодуль.ВыполнитьВПятьПотоков(ЭтотОбъект, "УвеличитьСчетчикСтоРаз", Карта);

	// Тогда

	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("Счетчик", 0)).Равно(500);

КонецПроцедуры

&Тест
Процедура Заменить() Экспорт

	// Дано

	Карта = КартаФикстура();

	// Когда

	Прошлое       = Карта.Заменить("а", 10);
	Отсутствующее = Карта.Заменить("г", 4);

	// Тогда

	Ожидаем.Что(Прошлое.Получить()).Равно(1);
	Ожидаем.Что(Отсутствующее.Пустой()).ЭтоИстина();
	Ожидаем.Что(Карта.ПолучитьИлиУмолчание("а", 0)).Равно(10);
