#Использовать asserts
#Использовать ".."

Перем ДляКаждогоВыполнилсяРаз; // Количество раз которое выполнился метод ДляКаждого

&Тест
Процедура ИтераторСоздается() Экспорт

	// Когда

	Результат = Новый ИтераторСнимок(Новый ФиксированныйМассив(Новый Массив));

	// Тогда

	Ожидаем.Что(Результат).ИмеетТип("ИтераторСнимок");

КонецПроцедуры

&Тест
Процедура ЕстьСледующий() Экспорт

	// Дано

	Итератор = Новый ИтераторСнимок(СнимокФикстура());

	// Когда

	Результат = Итератор.ЕстьСледующий();

	// Тогда

	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НетСледующего() Экспорт

	// Дано

	Итератор = Новый ИтераторСнимок(Новый ФиксированныйМассив(Новый Массив));

	// Когда

	Результат = Итератор.ЕстьСледующий();

	// Тогда

	Ожидаем.Что(Результат).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура Следующий() Экспорт

	// Дано

	Итератор = Новый ИтераторСнимок(СнимокФикстура());

	// Когда

	Результат = Итератор.Следующий();

	// Тогда

	Ожидаем.Что(Результат).Равно(1);

КонецПроцедуры

&Тест
Процедура СледующийВызываетИсключениеПриВыходеЗаГраницы() Экспорт

	// Дано

	Итератор = Новый ИтераторСнимок(Новый ФиксированныйМассив(Новый Массив));

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Следующий")
		.ВыбрасываетИсключение("Значение индекса выходит за пределы диапазона");

КонецПроцедуры

&Тест
Процедура ДляКаждогоОставшегося() Экспорт

	// Дано

	ДляКаждогоВыполнилсяРаз = 0;

	Итератор = Новый ИтераторСнимок(СнимокФикстура());

	// Когда

	Итератор.ДляКаждогоОставшегося(Новый Действие(ЭтотОбъект, "ДействиеДляКаждого"));

	// Тогда

	Ожидаем.Что(ДляКаждогоВыполнилсяРаз).Равно(3);
	Ожидаем.Что(Итератор.ЕстьСледующий()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура УдалитьНеПоддерживается() Экспорт

	// Дано

	Итератор = Новый ИтераторСнимок(СнимокФикстура());
	Итератор.Следующий();

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Удалить")
		.ВыбрасываетИсключение("Итератор снимка не поддерживает изменение коллекции");

КонецПроцедуры

Процедура ДействиеДляКаждого(Элемент) Экспорт

	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;

	Ожидаем.Что(Элемент).Равно(ДляКаждогоВыполнилсяРаз);

КонецПроцедуры

Функция СнимокФикстура()

	Массив = Новый Массив;
	Массив.Добавить(1);
	Массив.Добавить(2);
	Массив.Добавить(3);

	Возврат Новый ФиксированныйМассив(Массив);

КонецФункции
