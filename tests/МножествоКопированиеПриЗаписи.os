&Тест
Процедура ОбходитсяЦикломДляКаждого() Экспорт

	Если Не ТестМодуль.ЭтоДвижокВерсии2() Тогда
		Возврат;
	КонецЕсли;

	// Дано

	Множество = МножествоФикстура();

	Обойдено = Новый Массив;

	// Когда

	Для Каждого Элемент Из Множество Цикл
		Обойдено.Добавить(Элемент);
		Множество.Удалить(Элемент);
	КонецЦикла;

	// Тогда

	Ожидаем.Что(Элементы(Обойдено)).Равно("1,2,3");
	Ожидаем.Что(Множество.Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДобавлениеИзНесколькихПотоковДобавляетЭлементОдинРаз() Экспорт

	// Дано

	Множество = Новый МножествоКопированиеПриЗаписи();

	// Когда

	Результаты = ТестМодуль.ВыполнитьВПятьПотоков(ЭтотОбъект, "ДобавитьСтоЭлементов", Множество);

	// Тогда

	ВсегоДобавлено = 0;

	Для Каждого Результат Из Результаты Цикл
		ВсегоДобавлено = ВсегоДобавлено + Результат;
	КонецЦикла;

	Ожидаем.Что(ВсегоДобавлено).Равно(100);
	Ожидаем.Что(Множество.Количество()).Равно(100);

КонецПроцедуры

Функция ДобавитьСтоЭлементов(Множество) Экспорт

	Добавлено = 0;

	Для Счетчик = 1 По 100 Цикл

		Если Множество.Добавить(Счетчик) Тогда
			Добавлено = Добавлено + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Добавлено;

КонецФункции

Процедура ДействиеДляКаждого(Элемент) Экспорт

	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;

	Ожидаем.Что(Элемент).БольшеИлиРавно(1).МеньшеИлиРавно(3);

КонецПроцедуры

Функция МножествоФикстура()

	Множество = Новый МножествоКопированиеПриЗаписи();
	Множество.Добавить(1);
	Множество.Добавить(2);
	Множество.Добавить(3);

	Возврат Множество;

КонецФункции

Функция Элементы(Коллекция)

	// Порядок обхода множества не гарантируется, поэтому элементы сравниваются упорядоченными
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Упорядоченные = Массивы.Скопировать(Коллекция);
	Иначе
		Упорядоченные = Коллекция.ВМассив();
	КонецЕсли;

	Массивы.Сортировать(Упорядоченные, СравнениеЗначений.ПрямойПорядок());

	Возврат СтрСоединить(Упорядоченные, ",");

КонецФункции
