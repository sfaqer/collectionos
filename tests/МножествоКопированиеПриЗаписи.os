&Тест
Процедура ОбходПослеИзмененияВидитНовыеЭлементы() Экспорт

	// Дано

	Множество = МножествоФикстура();
	ИтераторДоИзменения = Множество.Итератор();

	// Когда

	Множество.Добавить(4);

	// Тогда

	Ожидаем.Что(Элементы(Множество)).Равно("1,2,3,4");

	КоличествоНовогоОбхода = 0;
	Итератор = Множество.Итератор();
	Пока Итератор.ЕстьСледующий() Цикл
		Итератор.Следующий();
		КоличествоНовогоОбхода = КоличествоНовогоОбхода + 1;
	КонецЦикла;

	КоличествоСтарогоОбхода = 0;
	Пока ИтераторДоИзменения.ЕстьСледующий() Цикл
		ИтераторДоИзменения.Следующий();
		КоличествоСтарогоОбхода = КоличествоСтарогоОбхода + 1;
	КонецЦикла;

	Ожидаем.Что(КоличествоНовогоОбхода).Равно(4);
	Ожидаем.Что(КоличествоСтарогоОбхода).Равно(3);

КонецПроцедуры

&Тест
Процедура ОбходыБезИзмененийПереиспользуютЭлементыСнимка() Экспорт

	// Дано

	Рефлектор = Новый Рефлектор;

	Множество = МножествоФикстура();
	Множество.Итератор();

	КешПервогоОбхода = Рефлектор.ПолучитьСвойство(Множество, "КешЭлементов");

	// Когда

	Множество.ВМассив();

	// Тогда

	Ожидаем.Что(КешПервогоОбхода).Не_().Равно(Неопределено);
	Ожидаем.Что(Рефлектор.ПолучитьСвойство(Множество, "КешЭлементов") = КешПервогоОбхода).ЭтоИстина();

	Множество.Добавить(4);

	Ожидаем.Что(Рефлектор.ПолучитьСвойство(Множество, "КешЭлементов")).Равно(Неопределено);

КонецПроцедуры

