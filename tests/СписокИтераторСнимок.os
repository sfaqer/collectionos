&Тест
Процедура Предыдущий() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());
	Итератор.Следующий();
	Итератор.Следующий();

	// Когда

	Результат = Итератор.Предыдущий();

	// Тогда

	Ожидаем.Что(Результат).Равно(2);
