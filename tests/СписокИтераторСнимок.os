&Тест
Процедура УдалитьНеПоддерживается() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());
	Итератор.Следующий();

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Удалить")
		.ВыбрасываетИсключение("Итератор снимка не поддерживает изменение коллекции");

КонецПроцедуры

&Тест
Процедура УстановитьНеПоддерживается() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());
	Итератор.Следующий();

	Параметры = Новый Массив;
	Параметры.Добавить(4);

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Установить", Параметры)
		.ВыбрасываетИсключение("Итератор снимка не поддерживает изменение коллекции");

КонецПроцедуры

&Тест
Процедура ВставитьНеПоддерживается() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());

	Параметры = Новый Массив;
	Параметры.Добавить(4);

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Вставить", Параметры)
		.ВыбрасываетИсключение("Итератор снимка не поддерживает изменение коллекции");

КонецПроцедуры

Процедура ДействиеДляКаждого(Элемент) Экспорт

	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;

	Ожидаем.Что(Элемент).Равно(ДляКаждогоВыполнилсяРаз);

КонецПроцедуры

Функция СнимокФикстура()

	Массив = Новый Массив;
	Массив.Добавить(1);
	Массив.Добавить(2);
	Массив.Добавить(3);

	Возврат Новый ФиксированныйМассив(Массив);

КонецФункции
