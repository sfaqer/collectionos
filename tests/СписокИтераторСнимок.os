#Использовать asserts
#Использовать ".."

Перем ДляКаждогоВыполнилсяРаз; // Количество раз которое выполнился метод ДляКаждого

&Тест
Процедура ИтераторСоздается() Экспорт

	// Когда

	Результат = Новый СписокИтераторСнимок(Новый ФиксированныйМассив(Новый Массив));

	// Тогда

	Ожидаем.Что(Результат).ИмеетТип("СписокИтераторСнимок");

КонецПроцедуры

&Тест
Процедура ЕстьСледующий() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());

	// Когда

	Результат = Итератор.ЕстьСледующий();

	// Тогда

	Ожидаем.Что(Результат).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НетСледующего() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());

	Итератор.Следующий();
	Итератор.Следующий();
	Итератор.Следующий();

	// Когда

	Результат = Итератор.ЕстьСледующий();

	// Тогда

	Ожидаем.Что(Результат).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура Следующий() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());

	// Когда

	Первый = Итератор.Следующий();
	Второй = Итератор.Следующий();

	// Тогда

	Ожидаем.Что(Первый).Равно(1);
	Ожидаем.Что(Второй).Равно(2);

КонецПроцедуры

&Тест
Процедура СледующийВызываетИсключениеПриВыходеЗаГраницы() Экспорт

	// Дано

	Итератор = Новый СписокИтераторСнимок(Новый ФиксированныйМассив(Новый Массив));

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Следующий")
		.ВыбрасываетИсключение("Значение индекса выходит за пределы диапазона");

	Ожидаем.Что(Итератор.СледующийИндекс()).Равно(0);

КонецПроцедуры

&Тест
Процедура ДляКаждогоОставшегося() Экспорт

	// Дано

	ДляКаждогоВыполнилсяРаз = 0;

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());

	// Когда

	Итератор.ДляКаждогоОставшегося(Новый Действие(ЭтотОбъект, "ДействиеДляКаждого"));

	// Тогда

	Ожидаем.Что(ДляКаждогоВыполнилсяРаз).Равно(3);
	Ожидаем.Что(Итератор.ЕстьСледующий()).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДляКаждогоОставшегосяЛямбдаКонтекстСтруктура() Экспорт

	// Дано

	Контекст = Новый Структура("СуммаЭлементов", 0);

	Итератор = Новый СписокИтераторСнимок(СнимокФикстура());
	Итератор.Следующий();

	// Когда

	Итератор.ДляКаждогоОставшегося(
		"Элемент -> Контекст.СуммаЭлементов = Контекст.СуммаЭлементов + Элемент",
		Новый Структура("Контекст", Контекст)
	);

	// Тогда

	Ожидаем.Что(Контекст.СуммаЭлементов).Равно(5);

КонецПроцедуры

