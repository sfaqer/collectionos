	// Тогда

	Ожидаем.Что(Список)
		.Метод("УдалитьПоИндексу", Параметры)
		.ВыбрасываетИсключение("Значение индекса выходит за пределы диапазона");

	Ожидаем.Что(Список.Количество()).Равно(3);

КонецПроцедуры

&Тест
Процедура УстановитьСуществует() Экспорт

	// Дано

	Список = СписокФикстура();

	// Когда

	Результат = Список.Установить(1, 20);

	// Тогда

	Ожидаем.Что(Результат).Равно(2);
	Ожидаем.Что(Элементы(Список)).Равно("1,20,3");

КонецПроцедуры

&Тест
Процедура УстановитьНеСуществует() Экспорт

	// Дано

	Список = СписокФикстура();

	Параметры = Новый Массив;
	Параметры.Добавить(3);
	Параметры.Добавить(4);

	// Тогда

	Ожидаем.Что(Список)
		.Метод("Установить", Параметры)
		.ВыбрасываетИсключение("Значение индекса выходит за пределы диапазона");

	Ожидаем.Что(Элементы(Список)).Равно("1,2,3");

КонецПроцедуры

&Тест
Процедура ПреставлениеПереопределяется() Экспорт

	// Дано

	Список = СписокФикстура();
	Список.Добавить(Список);
	Список.Добавить(ТестМодуль.ОбъектЗаглушка());

	// Когда

	Результат = Строка(Список);

	// Тогда

	Ожидаем.Что(Результат).Равно("[1, 2, 3, (Эта коллекция), Заглушка]");

КонецПроцедуры

&Тест
Процедура ОбходитсяЦикломДляКаждого() Экспорт

	Если Не ТестМодуль.ЭтоДвижокВерсии2() Тогда
		Возврат;
	КонецЕсли;

	// Дано

	Список = СписокФикстура();

	Обойдено = Новый Массив;

	// Когда

	Для Каждого Элемент Из Список Цикл
		Обойдено.Добавить(Элемент);
		Список.Удалить(Элемент);
	КонецЦикла;

	// Тогда

	Ожидаем.Что(Элементы(Обойдено)).Равно("1,2,3");
	Ожидаем.Что(Список.Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДобавлениеИзНесколькихПотоковНеТеряется() Экспорт

	// Дано

	Список = Новый СписокКопированиеПриЗаписи();

	// Когда

	ТестМодуль.ВыполнитьВПятьПотоков(ЭтотОбъект, "ДобавитьСтоЭлементов", Список);

	// Тогда

	Ожидаем.Что(Список.Количество()).Равно(500);

КонецПроцедуры

&Тест
Процедура ЧтениеПриКонкурентномИзмененииСогласовано() Экспорт

	// Дано

	Список = Новый СписокКопированиеПриЗаписи();

	// Когда

	Результаты = ТестМодуль.ВыполнитьВПятьПотоков(ЭтотОбъект, "ДобавлятьПарыИПроверятьЧетность", Список);

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Список.Количество()).Равно(500);

КонецПроцедуры

&Тест
Процедура ВнешняяБлокировкаУпорядочиваетИзмененияНоНеЧтение() Экспорт

	// Дано

	ПроверяемыйСписок   = Новый СписокКопированиеПриЗаписи();
	БлокировкаЗахвачена = Ложь;
	ЧтениеВыполнено     = Ложь;

	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "ДобавитьПодВнешнейБлокировкой");

	ОжидатьПризнак("БлокировкаЗахвачена");

	// Когда

	КоличествоПодЧужойБлокировкой = ПроверяемыйСписок.Количество();
	ЧтениеВыполнено = Истина;

	ПроверяемыйСписок.Добавить("основной поток");

	Задание.ОжидатьЗавершения();

	// Тогда

	Ожидаем.Что(КоличествоПодЧужойБлокировкой).Равно(0);
	Ожидаем.Что(ПроверяемыйСписок.Получить(0)).Равно("фоновое задание");
	Ожидаем.Что(ПроверяемыйСписок.Получить(1)).Равно("основной поток");

КонецПроцедуры

Функция ДобавитьСтоЭлементов(Список) Экспорт

	Для Счетчик = 1 По 100 Цикл
		Список.Добавить(Счетчик);
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ДобавлятьПарыИПроверятьЧетность(Список) Экспорт

	Пара = Новый СписокМассив;
	Пара.Добавить(1);
	Пара.Добавить(2);

	Для Счетчик = 1 По 50 Цикл // BSLLS:UnusedLocalVariable-off

		Список.ДобавитьВсе(Пара);

		Если Список.ВМассив().Количество() % 2 <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		КоличествоОбойденных = 0;

		Итератор = Список.Итератор();

		Пока Итератор.ЕстьСледующий() Цикл
			Итератор.Следующий();
			КоличествоОбойденных = КоличествоОбойденных + 1;
		КонецЦикла;

		Если КоличествоОбойденных % 2 <> 0 Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура ДобавитьПодВнешнейБлокировкой() Экспорт

	Блокировка = Новый БлокировкаРесурса(ПроверяемыйСписок);
	Блокировка.Заблокировать();

	БлокировкаЗахвачена = Истина;

	ОжидатьПризнак("ЧтениеВыполнено");

	ПроверяемыйСписок.Добавить("фоновое задание");

	Блокировка.Разблокировать();

КонецПроцедуры

Процедура ОжидатьПризнак(ИмяПризнака)

	Признаки = Новый Структура("БлокировкаЗахвачена, ЧтениеВыполнено");
	ПредельноеВремя = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < ПредельноеВремя Цикл

		Признаки.БлокировкаЗахвачена = БлокировкаЗахвачена;
		Признаки.ЧтениеВыполнено     = ЧтениеВыполнено;

		Если Признаки[ИмяПризнака] = Истина Тогда
			Возврат;
		КонецЕсли;

		Приостановить(5);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("Не дождались признака %1", ИмяПризнака);

КонецПроцедуры

Функция Инкремент(Элемент) Экспорт
	Возврат Элемент + 1;
КонецФункции

Функция БольшеИлиРавноДвум(Элемент) Экспорт
	Два = 2;
	Возврат Элемент >= Два;
КонецФункции

Процедура ДействиеДляКаждого(Элемент) Экспорт

	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;

	Ожидаем.Что(Элемент).Равно(ДляКаждогоВыполнилсяРаз);

КонецПроцедуры

Функция СписокФикстура()

	Список = Новый СписокКопированиеПриЗаписи();
	Список.Добавить(1);
	Список.Добавить(2);
	Список.Добавить(3);

	Возврат Список;

КонецФункции

Функция Элементы(Коллекция)

	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат СтрСоединить(Коллекция, ",");
	КонецЕсли;

	Возврат СтрСоединить(Коллекция.ВМассив(), ",");

КонецФункции
