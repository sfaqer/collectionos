&Тест
Процедура Сортировать() Экспорт

	// Дано

	Список = Новый СписокКопированиеПриЗаписи();
	Список.Добавить(3);
	Список.Добавить(1);
	Список.Добавить(2);

	Итератор = Список.Итератор();

	// Когда

	Список.Сортировать(СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Ожидаем.Что(Элементы(Список)).Равно("1,2,3");
	Ожидаем.Что(Итератор.Следующий()).Равно(3);

