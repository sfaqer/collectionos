#Использовать asserts

#Использовать ".."
#Использовать "./ТестМодуль"

Перем ДляКаждогоВыполнилсяРаз; // Количество раз которое выполнился метод ДляКаждого
Перем ПроверяемыйСписок;       // Список, с которым работают фоновые задания
Перем БлокировкаЗахвачена;     // Признак того что фоновое задание захватило блокировку списка
Перем ЧтениеВыполнено;         // Признак того что основной поток прочитал список под чужой блокировкой

&Тест
Процедура СписокКопированиеПриЗаписиСоздается() Экспорт

	// Когда

	Результат = Новый СписокКопированиеПриЗаписи();

	// Тогда

	Ожидаем.Что(Результат).ИмеетТип("СписокКопированиеПриЗаписи");
	Ожидаем.Что(Результат.Пусто()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СоздаетсяИзКоллекции() Экспорт

	// Дано

	Исходный = Новый СписокМассив;
	Исходный.Добавить(1);
	Исходный.Добавить(2);

	// Когда

	Результат = Новый СписокКопированиеПриЗаписи(Исходный);
	Исходный.Добавить(3);

	// Тогда

	Ожидаем.Что(Элементы(Результат)).Равно("1,2");

КонецПроцедуры

&Тест
Процедура Итератор() Экспорт

	// Дано

	Список = Новый СписокКопированиеПриЗаписи();

	// Когда

	Результат = Список.Итератор();

	// Тогда

	Ожидаем.Что(Результат).ИмеетТип("СписокИтераторСнимок");

КонецПроцедуры

&Тест
Процедура ИтераторНеВидитПоследующихИзменений() Экспорт

	// Дано

	Список = СписокФикстура();
	Итератор = Список.Итератор();

	// Когда

	Список.Добавить(4);
	Список.УдалитьПоИндексу(0);
	Список.Установить(0, 20);

	// Тогда

	Обойдено = Новый Массив;

	Пока Итератор.ЕстьСледующий() Цикл
		Обойдено.Добавить(Итератор.Следующий());
	КонецЦикла;

	Ожидаем.Что(Элементы(Обойдено)).Равно("1,2,3");
	Ожидаем.Что(Элементы(Список)).Равно("20,3,4");

КонецПроцедуры

&Тест
Процедура ИтераторНеПоддерживаетИзменение() Экспорт

	// Дано

	Итератор = СписокФикстура().Итератор();
	Итератор.Следующий();

	// Тогда

	Ожидаем.Что(Итератор)
		.Метод("Удалить")
		.ВыбрасываетИсключение("Итератор снимка не поддерживает изменение коллекции");

КонецПроцедуры

&Тест
Процедура ДляКаждого() Экспорт

	// Дано

	ДляКаждогоВыполнилсяРаз = 0;

	Список = СписокФикстура();

	// Когда

	Список.ДляКаждого(Новый Действие(ЭтотОбъект, "ДействиеДляКаждого"));

	// Тогда

	Ожидаем.Что(ДляКаждогоВыполнилсяРаз).Равно(3);

КонецПроцедуры

&Тест
Процедура ДляКаждогоЛямбдаКонтекстСтруктура() Экспорт

	// Дано

	Контекст = Новый Структура("СуммаЭлементов", 0);

	Список = СписокФикстура();

	// Когда

	Список.ДляКаждого(
		"Элемент -> Контекст.СуммаЭлементов = Контекст.СуммаЭлементов + Элемент",
		Новый Структура("Контекст", Контекст)
	);

	// Тогда

	Ожидаем.Что(Контекст.СуммаЭлементов).Равно(6);

КонецПроцедуры

