&Тест
Процедура ВМассив() Экспорт

	// Дано

	ПроверяемаяКоллекция = Новый ФиксированнаяКоллекцияЗначений(
		Соответствие(),
		Изменения
	);

	// Когда

	Результат = ПроверяемаяКоллекция.ВМассив();

	// Тогда

	Ожидаем.Что(Результат)
		.ИмеетТип("Массив")
		.ИмеетДлину(3)
		.Содержит(1)
		.Содержит(2)
		.Содержит(3);

КонецПроцедуры

&Тест
Процедура ПреставлениеПереопределяется() Экспорт
	
	// Дано

	ПроверяемаяКоллекция = Новый ФиксированнаяКоллекцияЗначений(
		Соответствие(),
		Изменения
	);
	
	// Когда

	Результат = Строка(ПроверяемаяКоллекция);

	// Тогда

	Ожидаем.Что(Результат)
		.Равно("[1, 2, 3]");

КонецПроцедуры

&Тест
Процедура ОбходитсяЦикломДляКаждого() Экспорт

	Если Не ТестМодуль.ЭтоДвижокВерсии2() Тогда
		Возврат;
	КонецЕсли;

	// Дано

	ПроверяемаяКоллекция = Новый ФиксированнаяКоллекцияЗначений(
		Соответствие(),
		Изменения
	);
	
	// Когда

	// Тогда

	Для каждого Элемент Из ПроверяемаяКоллекция Цикл
		
		Ожидаем.Что(Элемент)
			.БольшеИлиРавно(1)
			.МеньшеИлиРавно(3);

	КонецЦикла;

КонецПроцедуры

Процедура ДействиеДляКаждого(Элемент) Экспорт // BSLLS:UnusedParameters-off
	ДляКаждогоВыполнилсяРаз = ДляКаждогоВыполнилсяРаз + 1;	
КонецПроцедуры

Функция Соответствие()
	
	Результат = Новый Соответствие;

	Результат.Вставить("1", 1);
	Результат.Вставить("2", 2);
	Результат.Вставить("3", 3);

	Возврат Результат;

КонецФункции

Изменения = Новый СчетчикИзменений;
