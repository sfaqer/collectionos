	Ожидаем.Что(Массив[2]).Равно(1);
	Ожидаем.Что(Массив[3]).Равно(2);
	Ожидаем.Что(Массив[4]).Равно(2);
	Ожидаем.Что(Массив[5]).Равно(3);
	Ожидаем.Что(Массив[6]).Равно(3);

