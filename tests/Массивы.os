&Тест
Процедура Сортировать_БольшойМассив() Экспорт

	// Дано

	Массив = Новый Массив;
	ГСЧ = Новый ГенераторСлучайныхЧисел;

	Для Сч = 1 По 1000 Цикл
		Массив.Добавить(ГСЧ.СлучайноеЧисло(1, 10000));
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

