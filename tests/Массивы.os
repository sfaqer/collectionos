&Тест
Процедура ИзЭлементов() Экспорт

	// Когда

	Результат = Массивы.ИзЭлементов(
		1, 2, 3, 4, 5, 6, 7, 8, 9, 9
	);

	// Тогда

	Ожидаем.Что(Результат)
		.ИмеетТип("ФиксированныйМассив")
		.ИмеетДлину(10);

	Для Сч = 1 По 9 Цикл

		Ожидаем.Что(Результат[Сч - 1]).Равно(Сч);

	КонецЦикла;

	Ожидаем.Что(Результат[9]).Равно(9);

