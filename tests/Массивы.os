&Тест
Процедура Сортировать_СтрессРазличныеРазмеры() Экспорт

	// Дано

	ГСЧ = Новый ГенераторСлучайныхЧисел(42);

	Размеры = Новый Массив;
	Размеры.Добавить(1);
	Размеры.Добавить(2);
	Размеры.Добавить(3);
	Размеры.Добавить(7);
	Размеры.Добавить(15);
	Размеры.Добавить(31);
	Размеры.Добавить(63);
	Размеры.Добавить(64);
	Размеры.Добавить(65);
	Размеры.Добавить(127);
	Размеры.Добавить(128);
	Размеры.Добавить(200);

	Для Каждого Размер Из Размеры Цикл

		Массив = Новый Массив;

		Для Сч = 1 По Размер Цикл
			Массив.Добавить(ГСЧ.СлучайноеЧисло(1, 1000));
		КонецЦикла;

		// Когда

		Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

		// Тогда

		Для Сч = 0 По Массив.ВГраница() - 1 Цикл
			Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

