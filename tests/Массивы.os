&Тест
Процедура СкопироватьФиксированный() Экспорт

	// Дано

	Массив = Новый Массив;
	Массив.Добавить(1);
	Массив.Добавить(2);
	Массив.Добавить(3);

	Массив = Новый ФиксированныйМассив(Массив);

	// Когда

	Результат = Массивы.Скопировать(Массив);

	// Тогда

	Ожидаем.Что(Результат)
		.ИмеетТип("Массив")
		.ИмеетДлину(3)
		.Содержит(1)
		.Содержит(2)
		.Содержит(3)
		.Не_().Равно(Массив);

