		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	Сч = 100;
	Пока Сч >= 81 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	Сч = 140;
	Пока Сч >= 101 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

