&Тест
Процедура Сортировать_КомплексныйТестИнвариантов() Экспорт

	// Дано

	Массив = Новый Массив;

	ДлиныСерий = Новый Массив;
	ДлиныСерий.Добавить(50);
	ДлиныСерий.Добавить(30);
	ДлиныСерий.Добавить(20);
	ДлиныСерий.Добавить(40);
	ДлиныСерий.Добавить(15);
	ДлиныСерий.Добавить(25);
	ДлиныСерий.Добавить(35);
	ДлиныСерий.Добавить(45);

	ТекущееЗначение = 1;

	Для Каждого Длина Из ДлиныСерий Цикл

		КонечноеЗначение = ТекущееЗначение + Длина - 1;
		Сч = КонечноеЗначение;

		Пока Сч >= ТекущееЗначение Цикл
			Массив.Добавить(Сч);
			Сч = Сч - 1;
		КонецЦикла;

		ТекущееЗначение = КонечноеЗначение + 1;

	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Сортировать_СтабильностьСортировки() Экспорт

	// Дано - массив структур с ключом и порядковым номером

	Массив = Новый Массив;

	// Создаём элементы с одинаковыми ключами, но разными порядковыми номерами
	Для Сч = 1 По 10 Цикл
		Элемент = Новый Структура("Ключ, Номер", 1, Сч);
		Массив.Добавить(Элемент);
	КонецЦикла;

	// Добавляем элементы с другим ключом
	Для Сч = 11 По 20 Цикл
		Элемент = Новый Структура("Ключ, Номер", 2, Сч);
		Массив.Добавить(Элемент);
	КонецЦикла;

	// Когда - сортируем по ключу

	Массивы.Сортировать(Массив, "Первый, Второй -> ?(Первый.Ключ > Второй.Ключ, 1, ?(Первый.Ключ < Второй.Ключ, -1, 0))");

	// Тогда - порядок элементов с одинаковым ключом должен сохраниться

	Для Сч = 0 По 9 Цикл
		Ожидаем.Что(Массив[Сч].Ключ).Равно(1);
		Ожидаем.Что(Массив[Сч].Номер).Равно(Сч + 1);
	КонецЦикла;

	Для Сч = 10 По 19 Цикл
		Ожидаем.Что(Массив[Сч].Ключ).Равно(2);
		Ожидаем.Что(Массив[Сч].Номер).Равно(Сч + 1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Сортировать_СтабильностьПриГалопе() Экспорт

	// Дано - убывающие серии для активации слияния и галопа

	Массив = Новый Массив;

	// Серия 1: ключи 3,2,1 (убывающая) - после разворота 1,2,3
	Элемент = Новый Структура("Ключ, Номер", 3, 1);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 2, 2);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 1, 3);
	Массив.Добавить(Элемент);

	// Серия 2: ключи 6,5,4 (убывающая) - после разворота 4,5,6
	Элемент = Новый Структура("Ключ, Номер", 6, 4);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 5, 5);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 4, 6);
	Массив.Добавить(Элемент);

	// Серия 3: ключи 3,2,1 (убывающая) - после разворота 1,2,3
	// Это создаст дубликаты ключей для проверки стабильности
	Элемент = Новый Структура("Ключ, Номер", 3, 7);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 2, 8);
	Массив.Добавить(Элемент);
	Элемент = Новый Структура("Ключ, Номер", 1, 9);
	Массив.Добавить(Элемент);

	// Когда - сортируем по ключу

	Массивы.Сортировать(Массив, "Первый, Второй -> ?(Первый.Ключ > Второй.Ключ, 1, ?(Первый.Ключ < Второй.Ключ, -1, 0))");

	// Тогда - стабильность: элементы с одинаковым ключом сохраняют порядок

	// Ключ 1: номера 3, 9 (из серий 1 и 3)
	Ожидаем.Что(Массив[0].Ключ).Равно(1);
	Ожидаем.Что(Массив[0].Номер).Равно(3);
	Ожидаем.Что(Массив[1].Ключ).Равно(1);
	Ожидаем.Что(Массив[1].Номер).Равно(9);

	// Ключ 2: номера 2, 8
	Ожидаем.Что(Массив[2].Ключ).Равно(2);
	Ожидаем.Что(Массив[2].Номер).Равно(2);
	Ожидаем.Что(Массив[3].Ключ).Равно(2);
	Ожидаем.Что(Массив[3].Номер).Равно(8);

	// Ключ 3: номера 1, 7
	Ожидаем.Что(Массив[4].Ключ).Равно(3);
	Ожидаем.Что(Массив[4].Номер).Равно(1);
	Ожидаем.Что(Массив[5].Ключ).Равно(3);
	Ожидаем.Что(Массив[5].Номер).Равно(7);

	// Ключ 4: номер 6
	Ожидаем.Что(Массив[6].Ключ).Равно(4);
	Ожидаем.Что(Массив[6].Номер).Равно(6);

	// Ключ 5: номер 5
	Ожидаем.Что(Массив[7].Ключ).Равно(5);
	Ожидаем.Что(Массив[7].Номер).Равно(5);

	// Ключ 6: номер 4
	Ожидаем.Что(Массив[8].Ключ).Равно(6);
	Ожидаем.Что(Массив[8].Номер).Равно(4);

КонецПроцедуры
