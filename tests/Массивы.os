&Тест
Процедура Сортировать_ВсеОдинаковые() Экспорт

	// Дано

	Массив = Новый Массив;

	Для Сч = 1 По 50 Цикл
		Массив.Добавить(42);
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Ожидаем.Что(Массив).ИмеетДлину(50);

	Для Сч = 0 По 49 Цикл
		Ожидаем.Что(Массив[Сч]).Равно(42);
	КонецЦикла;

