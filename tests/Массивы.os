	Массив = Новый Массив;

	Для Сч = 1 По 50 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Для Сч = 100 По 149 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Ожидаем.Что(Массив).ИмеетДлину(100);

	Для Сч = 0 По 49 Цикл
		Ожидаем.Что(Массив[Сч]).Равно(Сч + 1);
	КонецЦикла;

	Для Сч = 50 По 99 Цикл
		Ожидаем.Что(Массив[Сч]).Равно(Сч + 50);
	КонецЦикла;

КонецПроцедуры

