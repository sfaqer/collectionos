&Тест
Процедура Подмассив_НачальныйИндексМеньшеНуля() Экспорт

	// Дано

	Массив = Новый Массив;
	Массив.Добавить(1);
	Массив.Добавить(2);
	Массив.Добавить(3);

	// Когда-Тогда

	Попытка
		Массивы.Подмассив(Массив, -1, 2);
		ВызватьИсключение "Ожидалось исключение";
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("начальный индекс меньше нуля");
	КонецПопытки;

