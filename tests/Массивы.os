&Тест
Процедура Сортировать_ОбратныйПорядок() Экспорт

	// Дано

	Массив = Новый Массив;
	Массив.Добавить(1);
	Массив.Добавить(5);
	Массив.Добавить(3);
	Массив.Добавить(2);
	Массив.Добавить(4);

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ОбратныйПорядок());

	// Тогда

	Ожидаем.Что(Массив[0]).Равно(5);
	Ожидаем.Что(Массив[1]).Равно(4);
	Ожидаем.Что(Массив[2]).Равно(3);
	Ожидаем.Что(Массив[3]).Равно(2);
	Ожидаем.Что(Массив[4]).Равно(1);

КонецПроцедуры

&Тест
Процедура Сортировать_ЛямбдаВыражение() Экспорт

	// Дано

	Массив = Новый Массив;
	Массив.Добавить(3);
	Массив.Добавить(1);
	Массив.Добавить(2);

	// Когда

	Массивы.Сортировать(
		Массив,
		"Первый, Второй -> ?(Первый > Второй, 1, ?(Первый < Второй, -1, 0))"
	);

	// Тогда

	Ожидаем.Что(Массив[0]).Равно(1);
	Ожидаем.Что(Массив[1]).Равно(2);
	Ожидаем.Что(Массив[2]).Равно(3);

КонецПроцедуры

&Тест
Процедура Сортировать_Строки() Экспорт

	// Дано

	Массив = Новый Массив;
	Массив.Добавить("банан");
	Массив.Добавить("яблоко");
	Массив.Добавить("апельсин");
	Массив.Добавить("груша");

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Ожидаем.Что(Массив[0]).Равно("апельсин");
	Ожидаем.Что(Массив[1]).Равно("банан");
	Ожидаем.Что(Массив[2]).Равно("груша");
	Ожидаем.Что(Массив[3]).Равно("яблоко");

КонецПроцедуры

