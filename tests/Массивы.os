	Размеры.Добавить(127);
	Размеры.Добавить(128);
	Размеры.Добавить(200);

	Для Каждого Размер Из Размеры Цикл

		Массив = Новый Массив;

		Для Сч = 1 По Размер Цикл
			Массив.Добавить(ГСЧ.СлучайноеЧисло(1, 1000));
		КонецЦикла;

		// Когда

		Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

		// Тогда

		Для Сч = 0 По Массив.ВГраница() - 1 Цикл
			Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
		КонецЦикла;

	КонецЦикла;

