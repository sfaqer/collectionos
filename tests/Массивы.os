&Тест
Процедура Сортировать_СерииУжеВПравильномПорядке() Экспорт

	// Дано - убывающие блоки для создания нескольких серий после разворота

	Массив = Новый Массив;

	// Серия 1: 20-1 (убывающая, после разворота 1-20)
	Сч = 20;
	Пока Сч >= 1 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Серия 2: 120-101 (убывающая, после разворота 101-120)
	Сч = 120;
	Пока Сч >= 101 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Серия 3: 220-201 (убывающая, после разворота 201-220)
	Сч = 220;
	Пока Сч >= 201 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Серия 4: 320-301 (убывающая, после разворота 301-320)
	Сч = 320;
	Пока Сч >= 301 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Сортировать_ЕстественнаяСерияНаПоследнемЭлементе() Экспорт

	// Дано - последний элемент образует отдельную серию

	Массив = Новый Массив;

	Для Сч = 1 По 63 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Массив.Добавить(100);
	Массив.Добавить(50);

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

