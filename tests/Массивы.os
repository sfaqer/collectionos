	// Дано

	Массив = Новый Массив;
	Сч = 100;

	Пока Сч >= 1 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 1 По 100 Цикл
		Ожидаем.Что(Массив[Сч - 1]).Равно(Сч);
	КонецЦикла;

