&Тест
Процедура Сортировать_СерииУжеВПравильномПорядке() Экспорт

	// Дано - серии уже отсортированы относительно друг друга

	Массив = Новый Массив;

	Для Сч = 1 По 20 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Для Сч = 100 По 120 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Для Сч = 200 По 220 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Для Сч = 300 По 320 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Сортировать_ЕстественнаяСерияНаПоследнемЭлементе() Экспорт

	// Дано - последний элемент образует отдельную серию

	Массив = Новый Массив;

	Для Сч = 1 По 63 Цикл
		Массив.Добавить(Сч);
	КонецЦикла;

	Массив.Добавить(100);
	Массив.Добавить(50);

	// Когда

	Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());

	// Тогда

	Для Сч = 0 По Массив.ВГраница() - 1 Цикл
		Ожидаем.Что(Массив[Сч] <= Массив[Сч + 1]).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Сортировать_ИнвариантXМеньшеВZ() Экспорт

	// Дано - для активации ветки X < Z при нарушении инварианта

	Массив = Новый Массив;

	Сч = 50;
	Пока Сч >= 1 Цикл
		Массив.Добавить(Сч);
		Сч = Сч - 1;
