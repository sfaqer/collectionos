#Использовать lambdas

// Преобразует массив в список
//
// Параметры:
//   Массив - Массив из Произвольный - Исходный массив для преобразования
//          - ФиксированныйМассив из Произвольный - Исходный массив для преобразования
//
// Возвращаемое значение:
//   Список - Список, содержащий элементы исходного массива
//
Функция КакСписок(Знач Массив) Экспорт

	Рефлектор = Новый Рефлектор;

	Результат = Новый СписокМассив();

	Рефлектор.УстановитьСвойство(
		Результат,
		"Массив",
		Скопировать(Массив)
	);

	Возврат Результат;

КонецФункции

// Преобразует массив в множество
//
// Параметры:
//   Массив - Массив из Произвольный - Исходный массив для преобразования
//          - ФиксированныйМассив из Произвольный - Исходный массив для преобразования
//
// Возвращаемое значение:
//   Множество - Множество, содержащее уникальные элементы исходного массива
//
Функция КакМножество(Массив) Экспорт

	Рефлектор = Новый Рефлектор;

	Результат = Новый МножествоСоответствие();

	Соответствие = Новый Соответствие;

	Для каждого Элемент Из Массив Цикл
		Соответствие.Вставить(Элемент, Истина);
	КонецЦикла;

	Рефлектор.УстановитьСвойство(
		Результат,
		"Соответствие",
		Соответствие
	);

	Возврат Результат;

КонецФункции

// Создает копию массива
//
// Параметры:
//   Массив - Массив из Произвольный - Исходный массив для копирования
//          - ФиксированныйМассив из Произвольный - Исходный массив для копирования
//
// Возвращаемое значение:
//   Массив - Новый массив, содержащий все элементы исходного массива
//
Функция Скопировать(Массив) Экспорт

	Если ТипЗнч(Массив) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив(Массив);
	Иначе
		Результат = Новый Массив(Новый ФиксированныйМассив(Массив));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Создает массив из указанных элементов
//
// Параметры:
//   Элемент1  - Произвольный - Элемент для создания массива
//   Элемент2  - Произвольный - Элемент для создания массива
//   Элемент3  - Произвольный - Элемент для создания массива
//   Элемент4  - Произвольный - Элемент для создания массива
//   Элемент5  - Произвольный - Элемент для создания массива
//   Элемент6  - Произвольный - Элемент для создания массива
//   Элемент7  - Произвольный - Элемент для создания массива
//   Элемент8  - Произвольный - Элемент для создания массива
//   Элемент9  - Произвольный - Элемент для создания массива
//   Элемент10 - Произвольный - Элемент для создания массива
//   Элемент11 - Произвольный - Элемент для создания массива
//   Элемент12 - Произвольный - Элемент для создания массива
//   Элемент13 - Произвольный - Элемент для создания массива
//   Элемент14 - Произвольный - Элемент для создания массива
//   Элемент15 - Произвольный - Элемент для создания массива
//   Элемент16 - Произвольный - Элемент для создания массива
//   Элемент17 - Произвольный - Элемент для создания массива
//   Элемент18 - Произвольный - Элемент для создания массива
//   Элемент19 - Произвольный - Элемент для создания массива
//   Элемент20 - Произвольный - Элемент для создания массива
//   Элемент21 - Произвольный - Элемент для создания массива
//   Элемент22 - Произвольный - Элемент для создания массива
//   Элемент23 - Произвольный - Элемент для создания массива
//   Элемент24 - Произвольный - Элемент для создания массива
//   Элемент25 - Произвольный - Элемент для создания массива
//   Элемент26 - Произвольный - Элемент для создания массива
//   Элемент27 - Произвольный - Элемент для создания массива
//   Элемент28 - Произвольный - Элемент для создания массива
//   Элемент29 - Произвольный - Элемент для создания массива
//   Элемент30 - Произвольный - Элемент для создания массива
//   Элемент31 - Произвольный - Элемент для создания массива
//   Элемент32 - Произвольный - Элемент для создания массива
//
// Возвращаемое значение:
//   ФиксированныйМассив - Массив, содержащий указанные элементы
//
Функция ИзЭлементов(
	// BSLLS:NumberOfParams-off
	// BSLLS:NumberOfOptionalParams-off
	// BSLLS:UnusedParameters-off
		Элемент1 = NULL, Элемент2 = NULL, Элемент3 = NULL, Элемент4 = NULL, Элемент5 = NULL,
		Элемент6 = NULL, Элемент7 = NULL, Элемент8 = NULL, Элемент9 = NULL, Элемент10 = NULL,
		Элемент11 = NULL, Элемент12 = NULL, Элемент13 = NULL, Элемент14 = NULL, Элемент15 = NULL,
		Элемент16 = NULL, Элемент17 = NULL, Элемент18 = NULL, Элемент19 = NULL, Элемент20 = NULL,
		Элемент21 = NULL, Элемент22 = NULL, Элемент23 = NULL, Элемент24 = NULL, Элемент25 = NULL,
		Элемент26 = NULL, Элемент27 = NULL, Элемент28 = NULL, Элемент29 = NULL, Элемент30 = NULL,
		Элемент31 = NULL, Элемент32 = NULL
	// BSLLS:NumberOfParams-on
	// BSLLS:NumberOfOptionalParams-on
	// BSLLS:UnusedParameters-on
	) Экспорт

	Результат = Новый Массив;

	Для сч = 1 По 32 Цикл

		Значение = Вычислить("Элемент" + сч);

		Если Значение = NULL Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(Значение);

	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

// Возвращает массив, сформированный из элементов переданного массива,
// с переданного начального индекса по переданный конечный индекс.
//
// Параметры:
//  Массив - Массив Из Произвольный - Исходный массив значений
//  НачальныйИндекс - Число - индекс исходного массива,
//   с которого включительно начинается перенос элементов в подмассив
//  КонечныйИндекс  - Число - индекс исходного массива,
//   которым включительно заканчивается перенос элементов в подмассив
//
// Возвращаемое значение:
//  Массив Из Произвольный - подмассив элементов.
//
Функция Подмассив(Массив, НачальныйИндекс, КонечныйИндекс) Экспорт

	Если Массив.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	ОшибкиПараметровМетода = Новый Массив;

	Если НачальныйИндекс < 0 Тогда
		ОшибкиПараметровМетода.Добавить("Для получения подмассива передан начальный индекс меньше нуля.");
	КонецЕсли;

	Если КонечныйИндекс < 0 Тогда
		ОшибкиПараметровМетода.Добавить("Для получения подмассива передан конечный индекс меньше нуля.");
	КонецЕсли;

	Если КонечныйИндекс < НачальныйИндекс Тогда
		ОшибкиПараметровМетода.Добавить("Для получения подмассива передан конечный индекс меньше начального индекса.");
	КонецЕсли;

	МаксимальныйИндекс = Массив.ВГраница();

	Если НачальныйИндекс > МаксимальныйИндекс Тогда
		ОшибкиПараметровМетода.Добавить("Для получения подмассива передан начальный индекс, выходящий за границы массива.");
	КонецЕсли;

	Если КонечныйИндекс > МаксимальныйИндекс Тогда
		ОшибкиПараметровМетода.Добавить("Для получения подмассива передан конечный индекс, выходящий за границы массива.");
	КонецЕсли;

	Если ОшибкиПараметровМетода.Количество() > 0 Тогда
		ТекстИсключения = СтрСоединить(ОшибкиПараметровМетода, Символы.ПС);
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	РазмерМассива = КонечныйИндекс - НачальныйИндекс + 1;

	Подмассив = Новый Массив(РазмерМассива);

	ИндексПодмассива = 0;

	Для Индекс = НачальныйИндекс По КонечныйИндекс Цикл
		Подмассив.Установить(ИндексПодмассива, Массив[Индекс]);
		ИндексПодмассива = ИндексПодмассива + 1;
	КонецЦикла;

	Возврат Подмассив;

КонецФункции

// Сортирует массив в соответствии с переданным алгоритмом
//
// Параметры:
//   Массив - Массив из Произвольный - Исходный массив для сортировки
//   СравнениеЗначений - Действие - Делегат на функцию с двумя параметрами
//    в которую передаются 2 элемента коллекции, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//                     - Строка - Лямбда выражение с двумя параметрами
//    в которую передаются 2 элемента коллекции, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Массивы.Сортировать(Массив, СравнениеЗначений.ПрямойПорядок());
//
////////
//
//    Массивы.Сортировать(
//        Массив,
//        "Первый, Второй -> {
//        | Если Первый > Второй Тогда
//        |     Возврат 1;
//        | ИначеЕсли Второй > Первый Тогда
//        |     Возврат -1;
//        | Иначе
//        |     Возврат 0;
//        | КонецЕсли;
//        |}"
//    );
//
Процедура Сортировать(Массив, Знач СравнениеЗначений, Знач Контекст = Неопределено) Экспорт

	Если ТипЗнч(СравнениеЗначений) = Тип("Строка") Тогда

		СравнениеЗначений = Лямбда.Выражение(СравнениеЗначений)
			.Интерфейс(ФункциональныеИнтерфейсы.БиФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			СравнениеЗначений.Контекст(Контекст);
		Иначе
			СравнениеЗначений.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		СравнениеЗначений = СравнениеЗначений.ВДействие();

	КонецЕсли;

	Если Массив.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;

	МинимальныйРазмерСерии = ВычислитьМинимальныйРазмерСерии(Массив.Количество());
	СтекСерий = Новый Массив;

	ТекущийИндекс = 0;

	Пока ТекущийИндекс < Массив.Количество() Цикл

		// Поиск естественной серии
		КонецСерии = НайтиКонецСерии(Массив, ТекущийИндекс, СравнениеЗначений);

		// Если серия слишком короткая, расширяем до минимального размера
		Если КонецСерии - ТекущийИндекс + 1 < МинимальныйРазмерСерии Тогда
			КонецСерии = Мин(ТекущийИндекс + МинимальныйРазмерСерии - 1, Массив.ВГраница());
			СортироватьБлокБинарно(Массив, ТекущийИндекс, КонецСерии, СравнениеЗначений);
		КонецЕсли;

		// Добавляем серию в стек
		СтекСерий.Добавить(Новый Структура("Начало, Конец", ТекущийИндекс, КонецСерии));

		// Проверяем инварианты и выполняем слияние при необходимости
		ПроверитьИнвариантыИСлить(Массив, СтекСерий, СравнениеЗначений);

		ТекущийИндекс = КонецСерии + 1;

	КонецЦикла;

	// Финальное слияние всех оставшихся серий
	ФинальноеСлияние(Массив, СтекСерий, СравнениеЗначений);

КонецПроцедуры

Функция ВычислитьМинимальныйРазмерСерии(Знач ДлинаМассива)

	Если ДлинаМассива < 64 Тогда
		Возврат ДлинаМассива;
	КонецЕсли;

	Результат = 0;

	Пока ДлинаМассива >= 64 Цикл
		Результат = Результат + (ДлинаМассива % 2);
		ДлинаМассива = Цел(ДлинаМассива / 2);
	КонецЦикла;

	Возврат Результат + ДлинаМассива;

КонецФункции

Функция НайтиКонецСерии(Массив, Знач Начало, СравнениеЗначений)

	Если Начало >= Массив.ВГраница() Тогда
		Возврат Начало;
	КонецЕсли;

	Конец = Начало;

	// Определяем направление серии
	Если СравнениеЗначений.Выполнить(Массив[Конец], Массив[Конец + 1]) <= 0 Тогда

		// Возрастающая серия
		Пока Конец < Массив.ВГраница()
			И СравнениеЗначений.Выполнить(Массив[Конец], Массив[Конец + 1]) <= 0 Цикл
			Конец = Конец + 1;
		КонецЦикла;

	Иначе

		// Убывающая серия - находим конец и разворачиваем
		Пока Конец < Массив.ВГраница()
			И СравнениеЗначений.Выполнить(Массив[Конец], Массив[Конец + 1]) > 0 Цикл
			Конец = Конец + 1;
		КонецЦикла;

		РазворотБлока(Массив, Начало, Конец);

	КонецЕсли;

	Возврат Конец;

КонецФункции

Процедура РазворотБлока(Массив, Знач Начало, Знач Конец)

	Пока Начало < Конец Цикл

		Временная = Массив[Начало];
		Массив[Начало] = Массив[Конец];
		Массив[Конец] = Временная;
		Начало = Начало + 1;
		Конец = Конец - 1;

	КонецЦикла;

КонецПроцедуры

Процедура СортироватьБлокБинарно(Массив, Знач Начало, Знач Конец, СравнениеЗначений)

	Для Индекс = Начало + 1 По Конец Цикл

		ТекущееЗначение = Массив[Индекс];

		// Бинарный поиск позиции вставки
		Позиция = БинарныйПоискПозиции(Массив, Начало, Индекс - 1, ТекущееЗначение, СравнениеЗначений);

		// Сдвигаем элементы вправо
		Сдвиг = Индекс - 1;
		Пока Сдвиг >= Позиция Цикл
			Массив[Сдвиг + 1] = Массив[Сдвиг];
			Сдвиг = Сдвиг - 1;
		КонецЦикла;

		Массив[Позиция] = ТекущееЗначение;

	КонецЦикла;

КонецПроцедуры

Функция БинарныйПоискПозиции(Массив, Знач Левая, Знач Правая, Знач Значение, СравнениеЗначений)

	Пока Левая <= Правая Цикл

		Середина = Левая + Цел((Правая - Левая) / 2);

		Если СравнениеЗначений.Выполнить(Значение, Массив[Середина]) < 0 Тогда
			Правая = Середина - 1;
		Иначе
			Левая = Середина + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Левая;

КонецФункции

Процедура ПроверитьИнвариантыИСлить(Массив, СтекСерий, СравнениеЗначений)

	Пока СтекСерий.Количество() > 1 Цикл

		ИндексПоследнего = СтекСерий.Количество() - 1;

		СерияX = СтекСерий[ИндексПоследнего];
		СерияY = СтекСерий[ИндексПоследнего - 1];

		ДлинаX = СерияX.Конец - СерияX.Начало + 1;
		ДлинаY = СерияY.Конец - СерияY.Начало + 1;

		Если СтекСерий.Количество() >= 3 Тогда

			СерияZ = СтекСерий[ИндексПоследнего - 2];
			ДлинаZ = СерияZ.Конец - СерияZ.Начало + 1;

			// Инвариант: |Z| > |Y| + |X|
			Если ДлинаZ <= ДлинаY + ДлинаX Тогда

				Если ДлинаX < ДлинаZ Тогда
					СлитьДвеСерии(Массив, СерияY, СерияX, СтекСерий, ИндексПоследнего - 1, СравнениеЗначений);
				Иначе
					СлитьДвеСерии(Массив, СерияZ, СерияY, СтекСерий, ИндексПоследнего - 2, СравнениеЗначений);
				КонецЕсли;

				Продолжить;

			КонецЕсли;

		КонецЕсли;

		// Инвариант: |Y| > |X|
		Если ДлинаY <= ДлинаX Тогда

			СлитьДвеСерии(Массив, СерияY, СерияX, СтекСерий, ИндексПоследнего - 1, СравнениеЗначений);

			Продолжить;

		КонецЕсли;

		// Инварианты соблюдены
		Прервать;

	КонецЦикла;

КонецПроцедуры

Процедура СлитьДвеСерии(Массив, Знач Серия1, Знач Серия2, СтекСерий, Знач ИндексВСтеке, СравнениеЗначений)

	// Серия1 должен быть левее Серия2
	Начало = Серия1.Начало;
	Конец = Серия2.Конец;

	// Проверяем, нужно ли слияние (последний элемент Серия1 <= первому элементу Серия2)
	Если СравнениеЗначений.Выполнить(Массив[Серия1.Конец], Массив[Серия2.Начало]) <= 0 Тогда

		// Серии уже в правильном порядке - просто обновляем стек
		СтекСерий.Удалить(ИндексВСтеке + 1);
		СтекСерий[ИндексВСтеке] = Новый Структура("Начало, Конец", Начало, Конец);

		Возврат;

	КонецЕсли;

	// Выполняем слияние
	ВыполнитьСлияние(Массив, Серия1.Начало, Серия1.Конец, Серия2.Начало, Серия2.Конец, СравнениеЗначений);

	// Обновляем стек
	СтекСерий.Удалить(ИндексВСтеке + 1);
	СтекСерий[ИндексВСтеке] = Новый Структура("Начало, Конец", Начало, Конец);

КонецПроцедуры

Процедура ВыполнитьСлияние(Массив, Знач Начало1, Знач Конец1, Знач Начало2, Знач Конец2, СравнениеЗначений)

	// Копируем левую часть во временный массив
	ЛевыйМассив = Подмассив(Массив, Начало1, Конец1);

	ИндексЛевого = 0;
	ИндексПравого = Начало2;
	ИндексРезультата = Начало1;

	// Слияние с режимом галопа
	СчетчикПобедЛевый = 0;
	СчетчикПобедПравый = 0;
	ПорогГалопа = 7;

	Пока ИндексЛевого <= ЛевыйМассив.ВГраница() И ИндексПравого <= Конец2 Цикл

		// Проверяем, нужно ли активировать режим галопа
		Если СчетчикПобедЛевый >= ПорогГалопа Тогда

			// Левый массив побеждает - находим позицию в левом массиве
			// где элементы становятся >= текущему правому элементу
			Позиция = ЭкспоненциальныйПоискВлево(
				ЛевыйМассив,
				ИндексЛевого,
				ЛевыйМассив.ВГраница(),
				Массив[ИндексПравого],
				СравнениеЗначений
			);

			// Копируем элементы из левого массива
			Пока ИндексЛевого < Позиция Цикл
				Массив[ИндексРезультата] = ЛевыйМассив[ИндексЛевого];
				ИндексЛевого = ИндексЛевого + 1;
				ИндексРезультата = ИндексРезультата + 1;
			КонецЦикла;

			СчетчикПобедЛевый = 0;
			СчетчикПобедПравый = 0;

			Продолжить;

		ИначеЕсли СчетчикПобедПравый >= ПорогГалопа Тогда

			// Правый массив побеждает - находим позицию в правом массиве
			// где элементы становятся >= текущему левому элементу
			Позиция = ЭкспоненциальныйПоискВправо(
				Массив,
				ИндексПравого,
				Конец2,
				ЛевыйМассив[ИндексЛевого],
				СравнениеЗначений
			);

			// Копируем элементы из правого массива
			Пока ИндексПравого < Позиция Цикл
				Массив[ИндексРезультата] = Массив[ИндексПравого];
				ИндексПравого = ИндексПравого + 1;
				ИндексРезультата = ИндексРезультата + 1;
			КонецЦикла;

			СчетчикПобедЛевый = 0;
			СчетчикПобедПравый = 0;

			Продолжить;

		КонецЕсли; // BSLLS:IfElseIfEndsWithElse-off

		ИндексРезультата = ИндексРезультата + 1;

	КонецЦикла;

	// Копируем оставшиеся элементы левого массива
	Пока ИндексЛевого <= ЛевыйМассив.ВГраница() Цикл
		Массив[ИндексРезультата] = ЛевыйМассив[ИндексЛевого];
		ИндексЛевого = ИндексЛевого + 1;
		ИндексРезультата = ИндексРезультата + 1;
	КонецЦикла;

	// Правый массив уже на месте

КонецПроцедуры

Функция ЭкспоненциальныйПоискВправо(Массив, Знач Начало, Знач Конец, Знач Значение, СравнениеЗначений)

	Если СравнениеЗначений.Выполнить(Значение, Массив[Начало]) < 0 Тогда
		Возврат Начало;
	КонецЕсли;

	Если СравнениеЗначений.Выполнить(Значение, Массив[Конец]) >= 0 Тогда
		Возврат Конец + 1;
	КонецЕсли;

	// Экспоненциальный поиск границы
	Смещение = 1;
	ТекущаяПозиция = Начало;

	Пока ТекущаяПозиция + Смещение <= Конец
		И СравнениеЗначений.Выполнить(Значение, Массив[ТекущаяПозиция + Смещение]) >= 0 Цикл
		ТекущаяПозиция = ТекущаяПозиция + Смещение;
		Смещение = Смещение * 2;
	КонецЦикла;

	// Бинарный поиск в найденном диапазоне
	Левая = ТекущаяПозиция;
	Правая = Мин(ТекущаяПозиция + Смещение, Конец);

	Возврат БинарныйПоискПозиции(Массив, Левая, Правая, Значение, СравнениеЗначений);

КонецФункции

Функция ЭкспоненциальныйПоискВлево(Массив, Знач Начало, Знач Конец, Знач Значение, СравнениеЗначений)

	Если СравнениеЗначений.Выполнить(Массив[Начало], Значение) > 0 Тогда
		Возврат Начало;
	КонецЕсли;

	Если СравнениеЗначений.Выполнить(Массив[Конец], Значение) <= 0 Тогда
		Возврат Конец + 1;
	КонецЕсли;

	// Экспоненциальный поиск границы
	Смещение = 1;
	ТекущаяПозиция = Начало;

	Пока ТекущаяПозиция + Смещение <= Конец
		И СравнениеЗначений.Выполнить(Массив[ТекущаяПозиция + Смещение], Значение) <= 0 Цикл
		ТекущаяПозиция = ТекущаяПозиция + Смещение;
		Смещение = Смещение * 2;
	КонецЦикла;

	// Бинарный поиск в найденном диапазоне
	Левая = ТекущаяПозиция;
	Правая = Мин(ТекущаяПозиция + Смещение, Конец);

	Возврат БинарныйПоискПозиции(Массив, Левая, Правая, Значение, СравнениеЗначений);

КонецФункции

Процедура ФинальноеСлияние(Массив, СтекСерий, СравнениеЗначений)

	Пока СтекСерий.Количество() > 1 Цикл

		ИндексПоследнего = СтекСерий.Количество() - 1;
		Серия2 = СтекСерий[ИндексПоследнего];
		Серия1 = СтекСерий[ИндексПоследнего - 1];

		СлитьДвеСерии(Массив, Серия1, Серия2, СтекСерий, ИндексПоследнего - 1, СравнениеЗначений);

	КонецЦикла;

КонецПроцедуры
