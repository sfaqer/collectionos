#Использовать fluent

Перем Соответствие; // Соответствие карты
Перем Источник;     // Карта владелец этого представления

// Возвращает итератор значений карты
//
// Возвращается итератор только для чтения, который обходит снимок пар, сформированный
//  в момент создания итератора. Изменение карты владельца во время обхода
//  приводит к исключению
//
//  Возвращаемое значение:
//   ЧитающийИтератор - Итератор значений карты
//
Функция Итератор() Экспорт

	Возврат Новый ФиксированныйИтератор(
		Новый ИтераторЗначениеСоответствие(Соответствие, Источник)
	);

КонецФункции

// Выполняет переданный алгоритм для каждого значения карты
//
// Обход выполняется через итератор представления, изменение карты владельца
//  внутри алгоритма приведёт к исключению
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передано значение карты
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передано значение карты
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Карта.Значения().ДляКаждого("Значение -> Сообщить(Значение)");
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	Итератор().ДляКаждогоОставшегося(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанное значение в карте
//
// Проверка выполняется перебором значений карты за линейное время
//
// Параметры:
//   Элемент - Произвольный - Проверяемое значение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит указанное значение
//
Функция Содержит(Элемент) Экспорт

	Итератор = Итератор();
	
	Пока Итератор.ЕстьСледующий() Цикл
		
		Если Итератор.Следующий() = Элемент Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Проверяет что карта содержит все значения из переданной коллекции
//
// Для каждого элемента переданной коллекции выполняется перебор значений карты,
//  проверка прекращается на первом ненайденном значении
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит все значения из переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	Результат = Истина;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Не Содержит(Итератор.Следующий()) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет что карта не содержит значений
//
//  Возвращаемое значение:
//   Булево - Истина, если карта не содержит значений
//
Функция Пусто() Экспорт
	Возврат Количество() = 0;
КонецФункции

// Возвращает процессор коллекции по значениям карты
//
// Процессор создаётся по копии значений, поэтому дальнейшие изменения карты
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ПроцессорыКоллекций.ИзКоллекции(ВМассив());
КонецФункции

// Возвращает количество значений карты
//
// Значения не уникальны, поэтому количество совпадает с количеством пар карты
//
//  Возвращаемое значение:
//   Число - Количество значений карты
//
Функция Количество() Экспорт
	Возврат Соответствие.Количество();
КонецФункции

// Выгружает значения карты в массив
//
// Возвращается копия значений, изменение полученного массива на карту не влияет
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив значений карты
//
Функция ВМассив() Экспорт

	Результат = Новый Массив;
	Итератор  = Итератор();
	
	Пока Итератор.ЕстьСледующий() Цикл
		Результат.Добавить(Итератор.Следующий());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Неизменяемое представление значений карты
//
// Работает поверх соответствия карты владельца, а не поверх его копии, поэтому всегда
//  отражает текущий состав значений карты. Изменить карту через представление нельзя.
// В отличие от представления ключей, значения не уникальны, поэтому все проверки
//  выполняются перебором.
// Экземпляры создаются картой самостоятельно, в прикладном коде используется
//  результат метода карты `Значения`
//
// Конструктор объекта
//
// Параметры:
//   пСоответствие - Соответствие - Соответствие, лежащее в основе карты, представление
//    работает поверх него без копирования
//   пИсточник     - Карта - Карта, представлением значений которой является объект,
//    используется итераторами для отслеживания изменений карты
//
&Обходимое
&Реализует("ЧитаемаяКоллекция")
Процедура ПриСозданииОбъекта(пСоответствие, пИсточник)

	Соответствие = пСоответствие;
	Источник     = пИсточник;

КонецПроцедуры
