#Использовать fluent

Перем Соответствие; // Соответствие карты
Перем Источник;     // Карта владелец этого представления

// Возвращает итератор пар ключ и значение карты
//
// Возвращается итератор только для чтения, который обходит снимок пар, сформированный
//  в момент создания итератора. Изменение карты владельца во время обхода
//  приводит к исключению
//
//  Возвращаемое значение:
//   ЧитающийИтератор - Итератор пар ключ и значение карты
//
Функция Итератор() Экспорт

	Возврат Новый ФиксированныйИтератор(
		Новый ИтераторСоответствие(Соответствие, Источник)
	);

КонецФункции

// Выполняет переданный алгоритм для каждой пары ключ и значение карты
//
// Обход выполняется через итератор представления, изменение карты владельца
//  внутри алгоритма приведёт к исключению
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передана пара ключ и значение
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передана пара ключ и значение
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Карта.КлючиИЗначения().ДляКаждого("Пара -> Сообщить(Пара.Ключ)");
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	Итератор().ДляКаждогоОставшегося(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанная пара ключ и значение в карте
//
// Значение ключа ищется за постоянное время и сравнивается со значением переданной пары,
//  поэтому пара с существующим ключом, но другим значением, считается не входящей в карту
//
// Параметры:
//   Элемент - КлючИЗначение - Проверяемая пара ключ и значение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит указанную пару ключ и значение
//
Функция Содержит(Элемент) Экспорт

	Значение = Соответствие.Получить(Элемент.Ключ);

	Возврат Значение <> Неопределено И Значение = Элемент.Значение;

КонецФункции

// Проверяет что карта содержит все пары ключ и значение из переданной коллекции
//
// Проверка прекращается на первой ненайденной паре
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция пар ключ и значение, которые проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит все пары из переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	Результат = Истина;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Не Содержит(Итератор.Следующий()) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет что карта не содержит пар ключ и значение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта не содержит пар ключ и значение
//
Функция Пусто() Экспорт
	Возврат Количество() = 0;
КонецФункции

// Возвращает процессор коллекции по парам ключ и значение карты
//
// Процессор создаётся по копии пар, поэтому дальнейшие изменения карты
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ПроцессорыКоллекций.ИзКоллекции(Соответствие);
КонецФункции

// Возвращает количество пар ключ и значение карты
//
//  Возвращаемое значение:
//   Число - Количество пар ключ и значение карты
//
Функция Количество() Экспорт
	Возврат Соответствие.Количество();
КонецФункции

// Выгружает пары ключ и значение карты в массив
//
// Возвращается копия пар, изменение полученного массива на карту не влияет
//
//  Возвращаемое значение:
//   Массив из КлючИЗначение - Массив пар ключ и значение карты
//
Функция ВМассив() Экспорт

	Результат = Новый Массив;
	Итератор  = Итератор();
	
	Пока Итератор.ЕстьСледующий() Цикл
		Результат.Добавить(Итератор.Следующий());
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	
	КартыСлужебный.ОбработчикПолученияПредставленияМножестваКлючейИЗначений(
		ЭтотОбъект,
		Представление,
		СтандартнаяОбработка
	);

КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Неизменяемое представление пар ключ и значение карты
//
// Работает поверх соответствия карты владельца, а не поверх его копии, поэтому всегда
//  отражает текущий состав пар карты. Изменить карту через представление нельзя.
// Элементами представления являются пары ключ и значение, поэтому методы проверки
//  вхождения ожидают объект с полями `Ключ` и `Значение`.
// Экземпляры создаются картой самостоятельно, в прикладном коде используется
//  результат метода карты `КлючиИЗначения`
//
// Конструктор объекта
//
// Параметры:
//   пСоответствие - Соответствие - Соответствие, лежащее в основе карты, представление
//    работает поверх него без копирования
//   пИсточник     - Карта - Карта, представлением пар которой является объект,
//    используется итераторами для отслеживания изменений карты
//
&Обходимое
&Реализует("ЧитаемоеМножество")
Процедура ПриСозданииОбъекта(пСоответствие, пИсточник)

	Соответствие = пСоответствие;
	Источник     = пИсточник;

КонецПроцедуры
