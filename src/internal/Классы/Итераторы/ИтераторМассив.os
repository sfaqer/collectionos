#Использовать lambdas

Перем ВнутреннийИтератор; // Ссылка на итератор массива

// Проверяет что есть следующий элемент коллекции
//
// Проверка выполняется по положению курсора итератора, модификация коллекции в обход итератора
//  этим методом не контролируется, она проверяется при получении элемента
//
//  Возвращаемое значение:
//   Булево - Истина, если есть следующий элемент коллекции
//
Функция ЕстьСледующий() Экспорт
	Возврат ВнутреннийИтератор.ЕстьСледующий();
КонецФункции

// Возвращает следующий элемент коллекции и сдвигает итератор вперёд
//
// Вызывает исключение, если коллекция была изменена в обход итератора.
// Полученный элемент становится текущим, что делает доступным метод `Удалить`
//
//  Возвращаемое значение:
//   Произвольный - Следующий элемент коллекции
//
Функция Следующий() Экспорт
	Возврат ВнутреннийИтератор.Следующий();
КонецФункции

// Удаляет из коллекции элемент, полученный последним вызовом `Следующий`
//
// Вызывает исключение, если элемент ещё не был получен, был удалён повторно, или если коллекция
//  была изменена в обход итератора.
// После удаления обход продолжается без пропуска элементов, остальные итераторы коллекции
//  становятся невалидными
//
Процедура Удалить() Экспорт
	ВнутреннийИтератор.Удалить();
КонецПроцедуры

// Выполняет переданный алгоритм для каждого элемента коллекции, начиная с того,
//  на который указывает итератор
//
// После выполнения итератор указывает на конец коллекции. Удаление элементов из коллекции
//  внутри алгоритма приведёт к исключению, для удаления по условию следует использовать
//  метод коллекции `УдалитьЕсли`
//
// Параметры:
//   Действие - Действие - Делегат на процедуру с одним параметром
//    которая принимает элемент коллекции
//            - Строка - Лямбда выражение с одним параметром
//    которая принимает элемент коллекции
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Итератор.ДляКаждогоОставшегося("Элемент -> Сообщить(Элемент)");
//
//    Итератор.ДляКаждогоОставшегося("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждогоОставшегося(Действие, Контекст = Неопределено) Экспорт
	ВнутреннийИтератор.ДляКаждогоОставшегося(Действие, Контекст);
КонецПроцедуры

// Однонаправленный итератор по массиву
//
// Ограничивает итератор списка до интерфейса `Итератор`, оставляя только обход вперёд
//  и удаление элементов. Обход выполняется непосредственно по массиву коллекции,
//  изменение коллекции в обход итератора приводит к исключению при продолжении обхода
//
// Конструктор объекта
//
// Параметры:
//   пМассив   - Массив из Произвольный - Массив, лежащий в основе коллекции, обход выполняется
//    по этому массиву без копирования
//   пИсточник - Коллекция - Коллекция, которой принадлежит итератор, используется для подписки
//    на изменения коллекции и для оповещения других итераторов об изменениях
//
&Реализует("Итератор")
Процедура ПриСозданииОбъекта(пМассив, пИсточник)
	ВнутреннийИтератор = Новый СписокИтераторМассив(пМассив, пИсточник);
КонецПроцедуры
