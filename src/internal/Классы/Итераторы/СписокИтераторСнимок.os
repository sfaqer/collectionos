#Использовать lambdas

Перем Снимок; // Итерируемый снимок элементов коллекции
Перем Курсор; // Индекс на который указывает итератор
Перем Размер; // Размер снимка

// Проверяет что есть следующий элемент снимка
//
//  Возвращаемое значение:
//   Булево - Истина, если есть следующий элемент снимка
//
Функция ЕстьСледующий() Экспорт
	Возврат Курсор <> Размер;
КонецФункции

// Возвращает следующий элемент снимка и сдвигает курсор итератора вперёд
//
// Снимок не меняется, поэтому изменение коллекции во время обхода исключения не вызывает
//
//  Возвращаемое значение:
//   Произвольный - Следующий элемент снимка
//
Функция Следующий() Экспорт

	Результат = Снимок[Курсор];
	Курсор    = Курсор + 1;

	Возврат Результат;

КонецФункции

// Не поддерживается, итератор снимка не изменяет коллекцию
//
// Всегда вызывает исключение, для удаления по условию следует использовать
//  метод коллекции `УдалитьЕсли`
//
Процедура Удалить() Экспорт
	ВызватьИсключениеИзменениеНеПоддерживается();
КонецПроцедуры

// Выполняет переданный алгоритм для каждого элемента снимка, начиная с того,
//  на который указывает итератор
//
// После выполнения итератор указывает на конец снимка. Коллекцию внутри алгоритма
//  можно изменять, на обход это не влияет
//
// Параметры:
//   Действие - Действие - Делегат на процедуру с одним параметром
//    которая принимает элемент коллекции
//            - Строка - Лямбда выражение с одним параметром
//    которая принимает элемент коллекции
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Итератор.ДляКаждогоОставшегося("Элемент -> Сообщить(Элемент)");
//
//    Итератор.ДляКаждогоОставшегося("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждогоОставшегося(Знач Действие, Знач Контекст = Неопределено) Экспорт

	Если Не ЕстьСледующий() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Действие) = Тип("Строка") Тогда

		Действие = Лямбда.Выражение(Действие)
			.Интерфейс(ФункциональныеИнтерфейсы.УниПроцедура());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Действие.Контекст(Контекст);
		Иначе
			Действие.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Действие = Действие.ВДействие();

	КонецЕсли;

	Пока ЕстьСледующий() Цикл
		Действие.Выполнить(Следующий());
	КонецЦикла;

КонецПроцедуры

// Проверяет что есть предыдущий элемент снимка
//
//  Возвращаемое значение:
//   Булево - Истина, если есть предыдущий элемент снимка
//
Функция ЕстьПредыдущий() Экспорт
	Возврат Курсор <> 0;
КонецФункции

// Возвращает предыдущий элемент снимка и сдвигает курсор итератора назад
//
//  Возвращаемое значение:
//   Произвольный - Предыдущий элемент снимка
//
Функция Предыдущий() Экспорт

	Результат = Снимок[Курсор - 1];
	Курсор    = Курсор - 1;

	Возврат Результат;

КонецФункции

// Возвращает индекс элемента, который будет возвращён следующим вызовом `Следующий`
//
// Для итератора, установленного на конец снимка, возвращает количество элементов снимка
//
//  Возвращаемое значение:
//   Число - Индекс на который указывает итератор
//
Функция СледующийИндекс() Экспорт
	Возврат Курсор;
КонецФункции

// Возвращает индекс элемента, который будет возвращён следующим вызовом `Предыдущий`
//
// Для итератора, установленного на начало снимка, возвращает -1
//
//  Возвращаемое значение:
//   Число - Предыдущий индекс от того на который указывает итератор
//
Функция ПредыдущийИндекс() Экспорт
	Возврат Курсор - 1;
КонецФункции

// Не поддерживается, итератор снимка не изменяет коллекцию
//
// Всегда вызывает исключение, для замены элементов следует использовать
//  методы списка `Установить` и `ЗаменитьВсе`
//
// Параметры:
//   Элемент - Произвольный - Устанавливаемый элемент
//
Процедура Установить(Элемент) Экспорт
	ВызватьИсключениеИзменениеНеПоддерживается();
КонецПроцедуры

// Не поддерживается, итератор снимка не изменяет коллекцию
//
// Всегда вызывает исключение, для вставки элементов следует использовать
//  методы списка `Вставить` и `ВставитьВсе`
//
// Параметры:
//   Элемент - Произвольный - Вставляемый элемент
//
Процедура Вставить(Элемент) Экспорт
	ВызватьИсключениеИзменениеНеПоддерживается();
КонецПроцедуры

Процедура ВызватьИсключениеИзменениеНеПоддерживается()
	ВызватьИсключение "Итератор снимка не поддерживает изменение коллекции";
КонецПроцедуры

// Двунаправленный итератор по неизменяемому снимку коллекции
//
// Обходит элементы коллекции в том виде, в котором они были на момент создания итератора.
// Изменения коллекции после создания итератора в обходе не видны и исключения не вызывают,
//  поэтому итератор не требует синхронизации и может использоваться одновременно
//  с изменением коллекции из других потоков.
// Изменение коллекции через итератор не поддерживается: методы `Удалить`, `Установить`
//  и `Вставить` вызывают исключение
//
// Конструктор объекта
//
// Параметры:
//   пСнимок - ФиксированныйМассив из Произвольный - Снимок элементов коллекции,
//    обход выполняется по нему без копирования
//
&Реализует("СписокИтератор")
Процедура ПриСозданииОбъекта(пСнимок)

	Снимок = пСнимок;
	Курсор = 0;
	Размер = Снимок.Количество();

КонецПроцедуры
