#Использовать lambdas

Перем Массив;                  // Итерируемый массив
Перем Курсор;                  // Индекс на который указывает итератор
Перем ПоследнийВозвращенный;   // Индекс последнего возвращенного элемента
Перем КоллекцияМодифицирована; // Признак того что коллекция была модифицирована вне итератора
Перем Источник;                // Коллекция которой принадлежит этот итератор
Перем Размер;                  // Размер итерируемого массива

// Проверяет что есть следующий элемент списка
//
// Проверка выполняется по положению курсора итератора, модификация списка в обход итератора
//  этим методом не контролируется, она проверяется при получении элемента
//
//  Возвращаемое значение:
//   Булево - Истина, если есть следующий элемент списка
//
Функция ЕстьСледующий() Экспорт
	Возврат Курсор <> Размер;
КонецФункции

// Возвращает следующий элемент списка и сдвигает курсор итератора вперёд
//
// Вызывает исключение, если список был изменён в обход итератора.
// Полученный элемент становится текущим, что делает доступными методы `Удалить` и `Установить`
//
//  Возвращаемое значение:
//   Произвольный - Следующий элемент списка
//
Функция Следующий() Экспорт

	ПроверитьМодифицированность();

	ПоследнийВозвращенный = Курсор;
	Курсор                = Курсор + 1;

	Возврат Массив[ПоследнийВозвращенный];

КонецФункции

// Удаляет из списка элемент, полученный последним вызовом `Следующий` или `Предыдущий`
//
// Вызывает исключение, если элемент ещё не был получен, повторно удалён или после последнего
//  получения элемента выполнялась вставка через итератор, а так же если список был изменён
//  в обход итератора.
// После удаления курсор итератора встаёт на место удалённого элемента, поэтому обход
//  продолжается без пропуска элементов, остальные итераторы этого списка становятся невалидными
//
Процедура Удалить() Экспорт
	
	Если ПоследнийВозвращенный < 0 Тогда
		ВызватьИсключение "Итератор не указывает на элемент коллекции";
	КонецЕсли;

	ПроверитьМодифицированность();

	Массив.Удалить(ПоследнийВозвращенный);

	Курсор                = ПоследнийВозвращенный;
	ПоследнийВозвращенный = -1;
	Размер                = Размер - 1;

	ОповеститьОбИзмененииКоллекции();

КонецПроцедуры

// Выполняет переданный алгоритм для каждого элемента списка, начиная с того,
//  на который указывает итератор
//
// После выполнения итератор указывает на конец списка. Удаление элементов из списка
//  внутри алгоритма приведёт к исключению, для удаления по условию следует
//  использовать метод списка `УдалитьЕсли`
//
// Параметры:
//   Действие - Действие - Делегат на процедуру с одним параметром
//    которая принимает элемент списка
//            - Строка - Лямбда выражение с одним параметром
//    которая принимает элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Итератор.ДляКаждогоОставшегося("Элемент -> Сообщить(Элемент)");
//
//    Итератор.ДляКаждогоОставшегося("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждогоОставшегося(Знач Действие, Знач Контекст = Неопределено) Экспорт

	Если Не ЕстьСледующий() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Действие) = Тип("Строка") Тогда

		Действие = Лямбда.Выражение(Действие)
			.Интерфейс(ФункциональныеИнтерфейсы.УниПроцедура());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Действие.Контекст(Контекст);
		Иначе
			Действие.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Действие = Действие.ВДействие();

	КонецЕсли;

	Пока ЕстьСледующий() Цикл
		Действие.Выполнить(Следующий());
	КонецЦикла;

КонецПроцедуры

// Проверяет что есть предыдущий элемент списка
//
//  Возвращаемое значение:
//   Булево - Истина, если есть предыдущий элемент списка
//
Функция ЕстьПредыдущий() Экспорт
	Возврат Курсор <> 0;
КонецФункции

// Возвращает предыдущий элемент списка и сдвигает курсор итератора назад
//
// Вызывает исключение, если список был изменён в обход итератора.
// Полученный элемент становится текущим, что делает доступными методы `Удалить` и `Установить`
//
//  Возвращаемое значение:
//   Произвольный - Предыдущий элемент списка
//
Функция Предыдущий() Экспорт

	ПроверитьМодифицированность();

	Курсор                = Курсор - 1;
	ПоследнийВозвращенный = Курсор;

	Возврат Массив[ПоследнийВозвращенный];

КонецФункции

// Возвращает индекс элемента, который будет возвращён следующим вызовом `Следующий`
//
// Для итератора, установленного на конец списка, возвращает количество элементов списка
//
//  Возвращаемое значение:
//   Число - Индекс на который указывает итератор
//
Функция СледующийИндекс() Экспорт
	Возврат Курсор;
КонецФункции

// Возвращает индекс элемента, который будет возвращён следующим вызовом `Предыдущий`
//
// Для итератора, установленного на начало списка, возвращает -1
//
//  Возвращаемое значение:
//   Число - Предыдущий индекс от того на который указывает итератор
//
Функция ПредыдущийИндекс() Экспорт
	Возврат Курсор - 1;
КонецФункции

Процедура КоллекцияМодифицирована(Итератор) // BSLLS:UnusedLocalMethod-off используется через ДобавитьОбработчик

	Если Итератор <> ЭтотОбъект Тогда
		КоллекцияМодифицирована = Истина;
	КонецЕсли;

КонецПроцедуры

// Заменяет в списке элемент, полученный последним вызовом `Следующий` или `Предыдущий`
//
// Вызывает исключение, если элемент ещё не был получен, был удалён через итератор
//  или после его получения выполнялась вставка через итератор, а так же если список
//  был изменён в обход итератора.
// Положение курсора итератора не меняется, остальные итераторы этого списка
//  становятся невалидными
//
// Параметры:
//   Элемент - Произвольный - Устанавливаемый элемент
//
Процедура Установить(Элемент) Экспорт

	Если ПоследнийВозвращенный < 0 Тогда
		ВызватьИсключение "Итератор не указывает на элемент коллекции";
	КонецЕсли;

	ПроверитьМодифицированность();

	Массив.Установить(ПоследнийВозвращенный, Элемент);

	ОповеститьОбИзмененииКоллекции();

КонецПроцедуры

// Вставляет элемент в список перед элементом, который будет возвращён вызовом `Следующий`
//
// Вызывает исключение, если список был изменён в обход итератора.
// Вставленный элемент при обходе вперёд пропускается, после вставки методы `Удалить`
//  и `Установить` недоступны до следующего получения элемента, остальные итераторы
//  этого списка становятся невалидными
//
// Параметры:
//   Элемент - Произвольный - Вставляемый элемент
//
Процедура Вставить(Элемент) Экспорт

	ПроверитьМодифицированность();

	Массив.Вставить(Курсор, Элемент);

	Размер = Размер + 1;
	Курсор = Курсор + 1;
	ПоследнийВозвращенный = -1;

	ОповеститьОбИзмененииКоллекции();

КонецПроцедуры

Процедура ПроверитьМодифицированность()
	Если КоллекцияМодифицирована Тогда
		ВызватьИсключение "Коллекция была изменена в процессе обхода";
	КонецЕсли;
КонецПроцедуры

Процедура ОповеститьОбИзмененииКоллекции()
	
	Параметры = Новый Массив();
	Параметры.Добавить(ЭтотОбъект);

	Источник.ВызватьСобытие("КоллекцияМодифицирована", Параметры);

КонецПроцедуры

// Итератор списка, реализованного на базе массива
//
// Работает непосредственно с массивом списка, поэтому изменения, выполненные через итератор,
//  сразу же видны в списке. Итератор отслеживает изменения списка выполненные в обход итератора
//  (в том числе через другой итератор этого же списка), и при попытке продолжить обход
//  вызывает исключение
//
// Конструктор объекта
//
// Параметры:
//   пМассив   - Массив из Произвольный - Массив, лежащий в основе списка, обход выполняется
//    по этому массиву без копирования
//   пИсточник - Список - Список, которому принадлежит итератор, используется для подписки
//    на изменения списка и для оповещения других итераторов об изменениях
//
&Реализует("СписокИтератор")
Процедура ПриСозданииОбъекта(пМассив, пИсточник)

	Массив   = пМассив;
	Источник = пИсточник;
	Курсор   = 0;
	Размер   = Массив.Количество();

	ПоследнийВозвращенный = -1;

	КоллекцияМодифицирована = Ложь;

	ДобавитьОбработчик Источник.КоллекцияМодифицирована, КоллекцияМодифицирована;

КонецПроцедуры
