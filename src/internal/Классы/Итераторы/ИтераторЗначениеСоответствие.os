#Использовать lambdas

Перем ВнутреннийИтератор; // Ссылка на итератор соответствия

// Проверяет что есть следующее значение
//
//  Возвращаемое значение:
//   Булево - Истина, если есть следующее значение
//
Функция ЕстьСледующий() Экспорт
	Возврат ВнутреннийИтератор.ЕстьСледующий();
КонецФункции

// Возвращает следующее значение и сдвигает итератор вперёд
//
// Вызывает исключение, если коллекция владелец была изменена в обход итератора
//
//  Возвращаемое значение:
//   Произвольный - Следующее значение соответствия
//
Функция Следующий() Экспорт
	Возврат ВнутреннийИтератор.Следующий().Значение;
КонецФункции

// Удаляет из соответствия пару, значение которой было получено последним вызовом `Следующий`
//
// Вызывает исключение, если значение ещё не было получено, было удалено повторно, или если
//  коллекция владелец была изменена в обход итератора.
// Остальные итераторы коллекции владельца становятся невалидными
//
Процедура Удалить() Экспорт
	ВнутреннийИтератор.Удалить();
КонецПроцедуры

// Выполняет переданный алгоритм для каждого значения, начиная с того,
//  на которое указывает итератор
//
// После выполнения итератор указывает на конец снимка. Изменение коллекции владельца
//  внутри алгоритма приведёт к исключению
//
// Параметры:
//   Действие - Действие - Делегат на процедуру с одним параметром
//    которая принимает значение
//            - Строка - Лямбда выражение с одним параметром
//    которая принимает значение
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Итератор.ДляКаждогоОставшегося("Значение -> Сообщить(Значение)");
//
Процедура ДляКаждогоОставшегося(Знач Действие, Знач Контекст = Неопределено) Экспорт

	Если Не ЕстьСледующий() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Действие) = Тип("Строка") Тогда

		Действие = Лямбда.Выражение(Действие)
			.Интерфейс(ФункциональныеИнтерфейсы.УниПроцедура());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Действие.Контекст(Контекст);
		Иначе
			Действие.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Действие = Действие.ВДействие();

	КонецЕсли;

	Пока ЕстьСледующий() Цикл
		Действие.Выполнить(Следующий());
	КонецЦикла;

КонецПроцедуры

// Итератор по значениям соответствия
//
// Обёртка над итератором пар ключ и значение соответствия, которая возвращает только значения.
// Обход выполняется по снимку пар, сформированному при создании итератора, гарантии
//  и ограничения совпадают с `ИтераторСоответствие`
//
// Конструктор объекта
//
// Параметры:
//   Соответствие - Соответствие - Соответствие, значения которого требуется обойти
//   Источник     - Карта - Карта, которой принадлежит итератор, используется
//    для подписки на изменения карты и для оповещения других итераторов об изменениях
//
&Реализует("Итератор")
Процедура ПриСозданииОбъекта(Соответствие, Источник)
	ВнутреннийИтератор = Новый ИтераторСоответствие(Соответствие, Источник);
КонецПроцедуры
