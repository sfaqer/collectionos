#Использовать optional
#Использовать lambdas

#Использовать "../../../internal"

Перем Снимок;     // Текущий снимок пар карты, после публикации не изменяется
Перем Блокировка; // Блокировка, упорядочивающая изменения карты

// Проверяет что карта содержит переданный ключ
//
// Проверка выполняется по снимку карты без блокировки за постоянное время
//
// Параметры:
//   Ключ - Произвольный - Проверяемый ключ
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит указанный ключ
//
Функция СодержитКлюч(Ключ) Экспорт
	Возврат Снимок.Получить(Ключ) <> Неопределено;
КонецФункции

// Проверяет что карта содержит указанное значение
//
// Проверка выполняется перебором снимка карты без блокировки за линейное время
//
// Параметры:
//   Значение - Произвольный - Проверяемое значение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта содержит указанное значение
//
Функция СодержитЗначение(Значение) Экспорт

	Для Каждого КлючИЗначение Из Снимок Цикл

		Если КлючИЗначение.Значение = Значение Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Выполняет переданное действие для каждой пары ключ и значение карты
//
// Обход выполняется по снимку карты без блокировки, изменять карту внутри алгоритма
//  допустимо, но на обход это не влияет
//
// Параметры:
//   Алгоритм - Действие - Делегат на метод с двумя параметрами который будет выполнятся
//    в первый параметр передаётся ключ во второй значение
//            - Строка - Лямбда выражение с двумя параметрами в первый параметр передаётся ключ во второй значение
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//     Карта.ДляКаждого("(Ключ, Значение) -> Сообщить(СтрШаблон(""Ключ: %1, Значение:2"", Ключ, Значение))");
//
Процедура ДляКаждого(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт

	ТекущийСнимок = Снимок;

	Если ТекущийСнимок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Алгоритм) = Тип("Строка") Тогда

		Алгоритм = Лямбда.Выражение(Алгоритм)
			.Интерфейс(ФункциональныеИнтерфейсы.БиПроцедура());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Алгоритм.Контекст(Контекст);
		Иначе
			Алгоритм.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Алгоритм = Алгоритм.ВДействие();

	КонецЕсли;

	Для Каждого КлючИЗначение Из ТекущийСнимок Цикл
		Алгоритм.Выполнить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

// Возвращает значение по ключу карты
//
// Выполняется по снимку карты без блокировки за постоянное время.
// Так как карта не хранит Неопределено, пустой опциональный означает именно отсутствие ключа
//
// Параметры:
//   Ключ - Произвольный - Ключ, по которому требуется получить значение
//
//  Возвращаемое значение:
//   Опциональный - Опциональный, в котором содержится полученное значение или
//    пустой опциональный, если карта не содержит указанного ключа
//
Функция Получить(Ключ) Экспорт
	Возврат ВОпциональный(Снимок.Получить(Ключ));
КонецФункции

// Возвращает значение по ключу карты, или ЗначениеПоУмолчанию если карта не содержит ключ
//
// В отличие от метода `Получить`, значение возвращается без обёртки в опциональный
//
// Параметры:
//   Ключ - Произвольный - Ключ, по которому требуется получить значение
//   ЗначениеПоУмолчанию - Произвольный - Значение, которое будет возвращено если карта не содержит ключ
//
//  Возвращаемое значение:
//   Произвольный - Значение полученное по ключу карты, или ЗначениеПоУмолчанию если карта не содержит ключ
//
Функция ПолучитьИлиУмолчание(Ключ, ЗначениеПоУмолчанию) Экспорт

	Значение = Снимок.Получить(Ключ);

	Если Значение = Неопределено Тогда
		Значение = ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает признак того что карта не содержит пар ключ и значение
//
//  Возвращаемое значение:
//   Булево - Истина, если карта не содержит пар ключ и значение
//
Функция Пусто() Экспорт
	Возврат Количество() = 0;
КонецФункции

// Возвращает множество ключей содержащихся в карте
//
// Возвращается неизменяемое множество ключей на момент вызова. Оно создаётся поверх
//  снимка карты без копирования, последующие изменения карты в нём не отражаются
//
//  Возвращаемое значение:
//   ЧитаемоеМножество - Множество ключей содержащихся в карте
//
Функция Ключи() Экспорт
	Возврат Новый ФиксированноеМножествоКлючей(Снимок);
КонецФункции

// Возвращает коллекцию значений содержащихся в карте
//
// Возвращается неизменяемая коллекция значений на момент вызова. Она создаётся поверх
//  снимка карты без копирования, последующие изменения карты в ней не отражаются
//
//  Возвращаемое значение:
//   ЧитаемаяКоллекция - Коллекция значений содержащихся в карте
//
Функция Значения() Экспорт
	Возврат Новый ФиксированнаяКоллекцияЗначений(Снимок);
КонецФункции

// Возвращает множество пар ключ и значение содержащихся в карте
//
// Возвращается неизменяемое множество пар на момент вызова. Оно создаётся поверх
//  снимка карты без копирования, последующие изменения карты в нём не отражаются
//
//  Возвращаемое значение:
//   ЧитаемоеМножество - Множество пар ключ и значение содержащихся в карте
//
Функция КлючиИЗначения() Экспорт
	Возврат Новый ФиксированноеМножествоКлючейИЗначений(Снимок);
КонецФункции

// Возвращает количество пар ключ и значение содержащихся в карте
//
//  Возвращаемое значение:
//   Число - Количество пар ключ и значение содержащихся в карте
//
Функция Количество() Экспорт
	Возврат Снимок.Количество();
КонецФункции

// Удаляет все элементы карты
//
// Ранее полученные представления и итераторы продолжают отражать прежний состав карты
//
Процедура Очистить() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Опубликовать(Новый Соответствие);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Вставляет в карту переданную пару ключ и значение
//
// Если карта уже содержит переданный ключ, его значение заменяется.
// Изменение копирует все пары карты и выполняется за линейное время.
// Вызывает исключение, если ключ или значение равны Неопределено
//
// Параметры:
//   Ключ - Произвольный - Вставляемый ключ
//   Значение - Произвольный - Вставляемое значение
//
//  Возвращаемое значение:
//   Опциональный - Значение, ранее было связанное с ключом,
//    пустой если карта не содержала ключа
//
Функция Вставить(Ключ, Значение) Экспорт

	ПроверитьКлючИЗначение(Ключ, Значение);

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ВОпциональный(ИсходныйСнимок.Получить(Ключ));

		ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Значение);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Вставляет все значения из переданной карты
//
// Все пары вставляются за одно копирование карты, поэтому другие потоки видят либо карту
//  без новых пар, либо со всеми сразу. Значения существующих ключей заменяются.
// Если переданная карта содержит Неопределено в качестве ключа или значения, вызывается
//  исключение и карта не изменяется
//
// Параметры:
//   Карта - ЧитаемаяКарта - Карта, значения из которой вставляются
//
Процедура ВставитьВсе(Карта) Экспорт

	ВставляемыеПары = Новый Соответствие;

	Итератор = Карта.КлючиИЗначения().Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		КлючИЗначение = Итератор.Следующий();

		ПроверитьКлючИЗначение(КлючИЗначение.Ключ, КлючИЗначение.Значение);

		ВставляемыеПары.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);

	КонецЦикла;

	Если ВставляемыеПары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		Пары = Новый Соответствие(Снимок);

		Для Каждого КлючИЗначение Из ВставляемыеПары Цикл
			Пары.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;

		Опубликовать(Пары);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Вставляет в карту переданную пару ключ и значение, если карта не содержит переданного ключа
//
// Проверка и вставка выполняются атомарно. Если карта уже содержит ключ, она не изменяется
//  и блокировка не захватывается
//
// Параметры:
//   Ключ - Произвольный - Вставляемый ключ
//   Значение - Произвольный - Вставляемое значение
//
//  Возвращаемое значение:
//   Опциональный - Значение, связанное с ключом, пустой если карта не содержала ключа
//
Функция ВставитьЕслиОтсутствует(Ключ, Значение) Экспорт

	Результат = Получить(Ключ);

	Если Результат.СодержитЗначение() Тогда
		Возврат Результат;
	КонецЕсли;

	ПроверитьКлючИЗначение(Ключ, Значение);

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ВОпциональный(ИсходныйСнимок.Получить(Ключ));

		Если Результат.Пустой() Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Значение);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Вычисляет значение для переданного ключа через функцию переназначения, если функция вернёт значение
//  то оно будет вставлено по указанному ключу, если функция вернёт Неопределено, то из карты будет удалён
//  переданный ключ, если ранее карта его содержала
//
// Функция переназначения вызывается всегда, в том числе для отсутствующего в карте ключа.
// Получение значения, вычисление и изменение карты выполняются атомарно под блокировкой,
//  поэтому длительная функция задерживает другие изменяющие потоки, но не читающие.
// Изменение карты внутри функции приведёт к исключению
//
// Параметры:
//   Ключ - Произвольный - Ключ, для которого вычисляется значение
//   ФункцияПереназначения - Действие - Делегат на функцию с двумя параметрами, в которую передаются ключ
//    и Опциональный от текущего значения ключа (пустой если ключа нет)
//                         - Строка - Лямбда выражение с двумя параметрами в которую будут переданы ключ
//    и Опциональный от текущего значения ключа (пустой если ключа нет)
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия во втором параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия во втором параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Опциональный - Новое значение ключа, пустой если ключ был удалён
//
// Пример:
//    Карта.ВычислитьБезусловно("Ключ", "(Ключ, Значение) -> ?(Значение.Пустой(), Истина, Ложь)")
//
//    Карта.ВычислитьБезусловно(
//        "Ключ",
//        "(Ключ, Значение) -> ?(Значение.Пустой() И ВернутьИстину, Истина, Ложь)",
//        Новый Структура("ВернутьИстину", Истина)
//    );
//
Функция ВычислитьБезусловно(Ключ, Знач ФункцияПереназначения, Знач Контекст = Неопределено) Экспорт

	Если ТипЗнч(ФункцияПереназначения) = Тип("Строка") Тогда
		ФункцияПереназначения = Лямбда.Выражение(ФункцияПереназначения)
			.Интерфейс(ФункциональныеИнтерфейсы.БиФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			ФункцияПереназначения.Контекст(Контекст);
		Иначе
			ФункцияПереназначения.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		ФункцияПереназначения = ФункцияПереназначения.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		СтароеЗначение = ВОпциональный(ИсходныйСнимок.Получить(Ключ));
		НовоеЗначение  = ФункцияПереназначения.Выполнить(Ключ, СтароеЗначение);

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		Если НовоеЗначение <> Неопределено Или СтароеЗначение.СодержитЗначение() Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, НовоеЗначение);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ВОпциональный(НовоеЗначение);

КонецФункции

// Вычисляет значение для переданного ключа, если текущая карта не содержит переданного ключа,
//  через функцию назначения, функция будет вызвана только если карта не содержит ключа,
//  если функция вернёт значение, оно будет вставлено в карту по указанному ключу,
//  если функция вернёт Неопределенно, то значение вставлено не будет
//
// Проверка отсутствия ключа, вычисление и вставка выполняются атомарно, поэтому при
//  одновременных вызовах из нескольких потоков значение для ключа вычисляется один раз.
// Если карта уже содержит ключ, блокировка не захватывается.
// Изменение карты внутри функции приведёт к исключению
//
// Параметры:
//   Ключ - Произвольный - Ключ, для которого вычисляется значение
//   ФункцияНазначения - Действие - Делегат на функцию с одним параметром, в которую передаётся переданный ключ
//                     - Строка - Лямбда выражение с одним параметром в который будет передан переданный ключ
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия во втором параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия во втором параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Опциональный - Новое значение ключа если оно было вычислено, или текущее значение ключа
//    если карта уже содержала переданный ключ
//
// Пример:
//    Карта.ВычислитьЕслиОтсутствует("Ключ", "(Ключ) -> СтрДлина(Ключ)")
//
//    Карта.ВычислитьЕслиОтсутствует("Ключ", "(Ключ) -> СтрДлина(Ключ) + Соль", Новый Структура("Соль", 123))
//
Функция ВычислитьЕслиОтсутствует(Ключ, Знач ФункцияНазначения, Знач Контекст = Неопределено) Экспорт

	Результат = Получить(Ключ);

	Если Результат.СодержитЗначение() Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ФункцияНазначения) = Тип("Строка") Тогда
		ФункцияНазначения = Лямбда.Выражение(ФункцияНазначения)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
			Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			ФункцияНазначения.Контекст(Контекст);
		Иначе
			ФункцияНазначения.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		ФункцияНазначения = ФункцияНазначения.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ВОпциональный(ИсходныйСнимок.Получить(Ключ));

		Если Результат.Пустой() Тогда

			НовоеЗначение = ФункцияНазначения.Выполнить(Ключ);

			ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

			Если НовоеЗначение <> Неопределено Тогда
				ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, НовоеЗначение);
			КонецЕсли;

			Результат = ВОпциональный(НовоеЗначение);

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Вычисляет значение для переданного ключа, если текущая карта содержит переданный ключ,
//  через функцию переназначения, функция будет вызвана только если карта содержит ключ,
//  если функция вернёт значение, оно будет вставлено в карту по указанному ключу,
//  если функция вернёт Неопределенно, то ключ будет удалён из карты
//
// В функцию переназначения передаётся распакованное текущее значение ключа, а не опциональный.
// Получение значения, вычисление и изменение карты выполняются атомарно. Если карта
//  не содержит ключ, блокировка не захватывается.
// Изменение карты внутри функции приведёт к исключению
//
// Параметры:
//   Ключ - Произвольный - Ключ, для которого вычисляется значение
//   ФункцияПереназначения - Действие - Делегат на функцию с двумя параметрами, в которую передаются ключ
//    и текущее значение ключа
//                         - Строка - Лямбда выражение с двумя параметрами, в которые передаются ключ и текущее
//    значение ключа
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия во втором параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия во втором параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Опциональный - Новое значение ключа, пустой если ключа не было в карте
//    или если ключ был удалён
//
// Пример:
//    Карта.ВычислитьЕслиПрисутствует("Ключ", "(Ключ, Значение) -> {
//        |   Если Ключ = ""Ключ"" Тогда
//        |       Возврат СтрДлина(Значение);
//        |   Иначе
//        |       Возврат Неопределенно;
//        |   КонецЕсли;
//        |}"
//    );
//
Функция ВычислитьЕслиПрисутствует(Ключ, Знач ФункцияПереназначения, Знач Контекст = Неопределено) Экспорт

	Если Не СодержитКлюч(Ключ) Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Если ТипЗнч(ФункцияПереназначения) = Тип("Строка") Тогда
		ФункцияПереназначения = Лямбда.Выражение(ФункцияПереназначения)
			.Интерфейс(ФункциональныеИнтерфейсы.БиФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
			Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			ФункцияПереназначения.Контекст(Контекст);
		Иначе
			ФункцияПереназначения.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		ФункцияПереназначения = ФункцияПереназначения.ВДействие();

	КонецЕсли;

	НовоеЗначение = Неопределено;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		ТекущееЗначение = ИсходныйСнимок.Получить(Ключ);

		Если ТекущееЗначение <> Неопределено Тогда

			НовоеЗначение = ФункцияПереназначения.Выполнить(Ключ, ТекущееЗначение);

			ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, НовоеЗначение);

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ВОпциональный(НовоеЗначение);

КонецФункции

// Объединяет текущее и переданное значение по указанному ключу через функцию переназначения,
//  функция будет вызвана только если существует текущее значение ключа, в ином случае будет вставлено значение
//  если функция вернёт значение, оно будет вставлено в карту по указанному ключу,
//  если функция вернёт Неопределенно, то ключ будет удалён из карты
//
// Получение значения, вычисление и изменение карты выполняются атомарно под блокировкой.
// Изменение карты внутри функции приведёт к исключению
//
// Параметры:
//   Ключ - Произвольный - Ключ, значения для которого требуется объединить
//   Значение - Произвольный - Новое значение ключа
//   ФункцияПереназначения - Действие - Делегат на функцию с двумя параметрами в которые передаются
//    существующее и новое значение ключа
//                         - Строка - Лямбда выражение с двумя параметрами в которые передаются
//    существующее и новое значение ключа
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в третьем параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в третьем параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Опциональный - Новое значение ключа, пустой если ключ был удалён
//
// Пример:
//    Карта.Слить("Ключ", 4, "(СуществующееЗначение, НовоеЗначение) ->
//        | Возврат ?(НовоеЗначение > СуществующееЗначение,
//        |     НовоеЗначение,
//        |     СуществующееЗначение
//        | );"
//    );
//
Функция Слить(Ключ, Значение, Знач ФункцияПереназначения, Знач Контекст = Неопределено) Экспорт

	Если ТипЗнч(ФункцияПереназначения) = Тип("Строка") Тогда

		ФункцияПереназначения = Лямбда.Выражение(ФункцияПереназначения)
			.Интерфейс(ФункциональныеИнтерфейсы.БиФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			ФункцияПереназначения.Контекст(Контекст);
		Иначе
			ФункцияПереназначения.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		ФункцияПереназначения = ФункцияПереназначения.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		СтароеЗначение = ИсходныйСнимок.Получить(Ключ);

		Если СтароеЗначение = Неопределено Тогда
			НовоеЗначение = Значение;
		Иначе
			НовоеЗначение = ФункцияПереназначения.Выполнить(СтароеЗначение, Значение);
			ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);
		КонецЕсли;

		Если НовоеЗначение <> Неопределено Или СтароеЗначение <> Неопределено Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, НовоеЗначение);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ВОпциональный(НовоеЗначение);

КонецФункции

// Заменяет значение по переданному ключу, если ключа в карте нет, то замена не происходит
//
// Проверка и замена выполняются атомарно. Если карта не содержит ключ,
//  блокировка не захватывается
//
// Параметры:
//   Ключ - Произвольный - Ключ, значение которого требуется заменить
//   Значение - Произвольный - Новое значение ключа
//
//  Возвращаемое значение:
//   Опциональный - Прошлое значение ключа, или пустой, если ключа не было
//
Функция Заменить(Ключ, Значение) Экспорт

	Если Не СодержитКлюч(Ключ) Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	ПроверитьКлючИЗначение(Ключ, Значение);

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ВОпциональный(ИсходныйСнимок.Получить(Ключ));

		Если Результат.СодержитЗначение() Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Значение);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Заменяет значение по переданному ключу с проверкой текущего значения,
//  если ключа в карте нет, то замена не происходит
//
// Текущее значение сравнивается с переданным на равенство. Проверка и замена выполняются
//  атомарно, поэтому метод подходит для оптимистичного изменения значения из нескольких
//  потоков. Если текущее значение не совпадает, блокировка не захватывается
//
// Параметры:
//   Ключ - Произвольный - Ключ, значение которого требуется заменить
//   ПрошлоеЗначение - Произвольный - Значение, которое должно быть связано с ключом для замены
//   Значение - Произвольный - Новое значение ключа
//
//  Возвращаемое значение:
//   Булево - Истина, если замена была произведена
//
Функция ЗаменитьЕслиЗначение(Ключ, ПрошлоеЗначение, Значение) Экспорт

	ТекущееЗначение = Снимок.Получить(Ключ);

	Если ТекущееЗначение = Неопределено Или ТекущееЗначение <> ПрошлоеЗначение Тогда
		Возврат Ложь;
	КонецЕсли;

	ПроверитьКлючИЗначение(Ключ, Значение);

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		ТекущееЗначение = ИсходныйСнимок.Получить(Ключ);

		Заменено = ТекущееЗначение <> Неопределено И ТекущееЗначение = ПрошлоеЗначение;

		Если Заменено Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Значение);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Заменено;

КонецФункции

// Заменяет значение для всех ключей карты, через функцию переназначения
//
// Новые значения вычисляются по снимку карты и публикуются за одно копирование, поэтому
//  другие потоки видят либо только прежние значения, либо только новые.
// Функция переназначения не должна возвращать Неопределено, в этом случае вызывается
//  исключение и карта не изменяется.
// Блокировка удерживается на протяжении всей замены, поэтому длительная функция
//  задерживает другие изменяющие потоки, но не читающие.
// Изменение карты внутри функции приведёт к исключению
//
// Параметры:
//   ФункцияПереназначения - Действие - Делегат на функцию с двумя параметрами, в которую
//    передаются ключ и значение ключа
//                         - Строка - Лямбда выражение с двумя параметрами, в которые передаются
//    ключ и значение ключа
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Карта.ЗаменитьВсе("(Ключ, Значение) -> Значение + 1")
//
//    Карта.ЗаменитьВсе("(Ключ, Значение) -> Значение + Соль", Новый Структура("Соль", 123));
//
Процедура ЗаменитьВсе(Знач ФункцияПереназначения, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ФункцияПереназначения) = Тип("Строка") Тогда

		ФункцияПереназначения = Лямбда.Выражение(ФункцияПереназначения)
			.Интерфейс(ФункциональныеИнтерфейсы.БиФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			ФункцияПереназначения.Контекст(Контекст);
		Иначе
			ФункцияПереназначения.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		ФункцияПереназначения = ФункцияПереназначения.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Пары = Новый Соответствие;

		Для Каждого КлючИЗначение Из ИсходныйСнимок Цикл

			НовоеЗначение = ФункцияПереназначения.Выполнить(КлючИЗначение.Ключ, КлючИЗначение.Значение);

			ПроверитьКлючИЗначение(КлючИЗначение.Ключ, НовоеЗначение);

			Пары.Вставить(КлючИЗначение.Ключ, НовоеЗначение);

		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		Опубликовать(Пары);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет переданный ключ из карты
//
// Если карта не содержит ключ, она не изменяется и блокировка не захватывается
//
// Параметры:
//   Ключ - Произвольный - Удаляемый ключ
//
//  Возвращаемое значение:
//   Опциональный - Значение, ранее было связанное с ключом,
//    пустой если карта не содержала ключа
//
Функция Удалить(Ключ) Экспорт

	Если Не СодержитКлюч(Ключ) Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ВОпциональный(ИсходныйСнимок.Получить(Ключ));

		Если Результат.СодержитЗначение() Тогда
			ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Неопределено);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура ОпубликоватьЗначениеКлюча(ИсходныйСнимок, Ключ, Значение)

	Пары = Новый Соответствие(ИсходныйСнимок);

	Если Значение = Неопределено Тогда
		Пары.Удалить(Ключ);
	Иначе
		ПроверитьКлючИЗначение(Ключ, Значение);
		Пары.Вставить(Ключ, Значение);
	КонецЕсли;

	Опубликовать(Пары);

КонецПроцедуры

Процедура Опубликовать(Пары)
	Снимок = Новый ФиксированноеСоответствие(Пары);
КонецПроцедуры

Процедура ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок)

	// Под блокировкой снимок может смениться только изнутри функции, переданной
	//  в изменяющий метод, и публикация результата молча перетёрла бы это изменение
	Если Снимок <> ИсходныйСнимок Тогда
		ВызватьИсключение "Коллекция была изменена в процессе обхода";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКлючИЗначение(Ключ, Значение)

	Если Ключ = Неопределено Или Значение = Неопределено Тогда
		ВызватьИсключение "Неопределено не может быть в качестве ключа или значения карты";
	КонецЕсли;

КонецПроцедуры

Функция ВОпциональный(Значение)

	Если Значение = Неопределено Тогда
		Возврат Опциональные.Пустой();
	КонецЕсли;

	Возврат Новый Опциональный(Значение);

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КартыСлужебный.ОбработчикПолученияПредставленияКарты(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

// Потокобезопасная карта с копированием при записи
//
// Пары хранятся в неизменяемом снимке, каждое изменение копирует снимок, изменяет копию
//  и публикует её как новый снимок. Поэтому чтение, обход и представления карты работают
//  без блокировок и никогда не видят карту в промежуточном состоянии.
// Получение значения и проверка ключа выполняются за постоянное время, поиск по значению
//  и любое изменение - за линейное время от размера карты. Вызовы, которые заведомо
//  не меняют карту (например удаление отсутствующего ключа или `ВставитьЕслиОтсутствует`
//  для существующего), не копируют снимок и не захватывают блокировку.
// Методы вычисления и условной замены выполняются атомарно, поэтому подходят для
//  одновременного изменения одного ключа из нескольких потоков.
// Представления `Ключи`, `Значения` и `КлючиИЗначения` отражают состав карты на момент
//  их получения. Ни ключ, ни значение не могут быть Неопределено.
// Изменения упорядочиваются блокировкой на самой карте, поэтому несколько изменений
//  можно выполнить атомарно, захватив `Новый БлокировкаРесурса(Карта)`.
// Подходит для карт, которые читаются значительно чаще, чем изменяются, например
//  реестров и кешей настроек. При частых изменениях дешевле `СинхронизированнаяКарта`
//
// Конструктор объекта
//
// Пары переданной карты копируются в создаваемую карту,
//  дальнейшие изменения переданной карты в ней не отражаются
//
// Параметры:
//   Карта - ЧитаемаяКарта - Карта, парами которой будет заполнена создаваемая карта
//
// Пример:
//    Реестр = Новый КартаКопированиеПриЗаписи();
//
//    Карта = Новый КартаКопированиеПриЗаписи(ДругаяКарта);
//
&Реализует("Карта")
Процедура ПриСозданииОбъекта(Карта = Неопределено)

	Снимок     = Новый ФиксированноеСоответствие(Новый Соответствие);
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

	Если Карта <> Неопределено Тогда
		ВставитьВсе(Карта);
	КонецЕсли;

КонецПроцедуры
