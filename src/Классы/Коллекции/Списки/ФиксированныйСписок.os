#Использовать fluent

#Использовать "../../../internal"

Перем ВнутреннийСписок; // Ссылка на внутренний список

// Возвращает итератор списка
//
// Возвращается двунаправленный итератор только для чтения, изменение списка через него
//  недоступно
//
//  Возвращаемое значение:
//   ЧитающийСписокИтератор - Итератор списка
//
Функция Итератор() Экспорт
	
	Возврат Новый ФиксированныйСписокИтератор(
		ВнутреннийСписок.Итератор()
	);

КонецФункции

// Выполняет переданный алгоритм для каждого элемента списка
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент списка
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    список.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	ВнутреннийСписок.ДляКаждого(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанный элемент в списке
//
// Сложность операции определяется коллекцией, лежащей в основе представления
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат ВнутреннийСписок.Содержит(Элемент);
КонецФункции

// Проверяет что список содержит все элементы переданной коллекции
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт
	Возврат ВнутреннийСписок.СодержитВсе(Коллекция);
КонецФункции

// Проверяет что список пустой
//
//  Возвращаемое значение:
//   Булево - Истина, если список пуст
//
Функция Пусто() Экспорт
	Возврат ВнутреннийСписок.Пусто();
КонецФункции

// Возвращает процессор коллекции по элементам списка
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ВнутреннийСписок.ПроцессорКоллекции();
КонецФункции

// Возвращает количество элементов списка
//
//  Возвращаемое значение:
//   Число - Количество элементов списка
//
Функция Количество() Экспорт
	Возврат ВнутреннийСписок.Количество();
КонецФункции

// Получает элемент списка по индексу
//
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс - Число - Индекс, по которому требуется получить элемент списка
//
//  Возвращаемое значение:
//   Произвольный - Элемент списка по переданному индексу
//
Функция Получить(Индекс) Экспорт
	Возврат ВнутреннийСписок.Получить(Индекс);
КонецФункции

// Возвращает индекс первого вхождения переданного элемента
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция Индекс(Элемент) Экспорт
	Возврат ВнутреннийСписок.Индекс(Элемент);
КонецФункции

// Возвращает индекс последнего вхождения переданного элемента
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция ПоследнийИндекс(Элемент) Экспорт
	Возврат ВнутреннийСписок.ПоследнийИндекс(Элемент);
КонецФункции

// Возвращает максимальный индекс списка
//
// Для пустого списка возвращает -1
//
//  Возвращаемое значение:
//   Число - Максимальный индекс списка
//
Функция ВГраница() Экспорт
	Возврат ВнутреннийСписок.ВГраница();
КонецФункции

// Выгружает элементы списка в массив
//
// Возвращается копия элементов, изменение полученного массива на представление не влияет
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов списка
//
Функция ВМассив() Экспорт
	Возврат ВнутреннийСписок.ВМассив();
КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Неизменяемое представление списка
//
// Предоставляет только методы чтения, изменить список через это представление нельзя.
// В отличие от синхронизированных представлений, конструктор копирует элементы переданной
//  коллекции, поэтому дальнейшие изменения исходной коллекции в представлении не видны
//
// Конструктор объекта
//
// Элементы переданной коллекции копируются в список того же типа, а если передан объект
//  стороннего класса или коллекция не передана вовсе - в список на базе массива,
//  порядок элементов при этом сохраняется.
// Дальнейшие изменения переданной коллекции в представлении не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут скопированы в представление
//
// Пример:
//    Список = Новый ФиксированныйСписок(ИсходныйСписок);
//
&Обходимое
&Реализует("ЧитаемыйСписок")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)
	
	Если Коллекция = Неопределено Тогда
		ВнутреннийСписок = Новый СписокМассив();
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Сценарий") Тогда
		ВнутреннийСписок = Новый СписокМассив();
		ВнутреннийСписок.ДобавитьВсе(Коллекция);
	Иначе
		ВнутреннийСписок = Новый(ТипЗнч(Коллекция));
		ВнутреннийСписок.ДобавитьВсе(Коллекция);
	КонецЕсли;	
	
КонецПроцедуры
