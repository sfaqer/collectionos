#Использовать fluent
#Использовать lambdas

#Использовать "../../../internal"

Перем Снимок;     // Текущий снимок элементов списка, после публикации не изменяется
Перем Блокировка; // Блокировка, упорядочивающая изменения списка

// Возвращает итератор списка
//
// Итератор обходит снимок элементов, сформированный в момент его создания, поэтому
//  изменения списка после создания итератора в обходе не видны и исключения не вызывают.
// Изменение списка через итератор не поддерживается
//
//  Возвращаемое значение:
//   СписокИтератор - Итератор по снимку списка
//
Функция Итератор() Экспорт
	Возврат Новый СписокИтераторСнимок(Снимок);
КонецФункции

// Выполняет переданный алгоритм для каждого элемента списка
//
// Обход выполняется по снимку списка без блокировки, изменять список внутри алгоритма
//  допустимо, но на обход это не влияет
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент списка
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
//    Список.ДляКаждого("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждого(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт
	Итератор().ДляКаждогоОставшегося(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанный элемент в списке
//
// Поиск выполняется по снимку списка без блокировки за линейное время
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат Снимок.Найти(Элемент) <> Неопределено;
КонецФункции

// Проверяет что список содержит все элементы переданной коллекции
//
// Все проверки выполняются по одному снимку списка, поэтому результат согласован
//  даже при одновременном изменении списка из других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	ТекущийСнимок = Снимок;

	Результат = Истина;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если ТекущийСнимок.Найти(Итератор.Следующий()) = Неопределено Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет что список пустой
//
//  Возвращаемое значение:
//   Булево - Истина, если список пуст
//
Функция Пусто() Экспорт
	Возврат Снимок.Количество() = 0;
КонецФункции

// Возвращает процессор коллекции по элементам списка
//
// Процессор создаётся по копии снимка списка, поэтому дальнейшие изменения списка
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ПроцессорыКоллекций.ИзКоллекции(ВМассив());
КонецФункции

// Возвращает количество элементов списка
//
//  Возвращаемое значение:
//   Число - Количество элементов списка
//
Функция Количество() Экспорт
	Возврат Снимок.Количество();
КонецФункции

// Получает элемент списка по индексу
//
// Выполняется без блокировки за постоянное время.
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс - Число - Индекс, по которому требуется получить элемент списка
//
//  Возвращаемое значение:
//   Произвольный - Элемент списка по переданному индексу
//
Функция Получить(Индекс) Экспорт
	Возврат Снимок.Получить(Индекс);
КонецФункции

// Возвращает индекс первого вхождения переданного элемента
//
// Поиск выполняется по снимку списка без блокировки за линейное время
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция Индекс(Элемент) Экспорт

	Результат = Снимок.Найти(Элемент);

	Если Результат = Неопределено Тогда
		Результат = -1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает индекс последнего вхождения переданного элемента
//
// Поиск выполняется перебором снимка списка от конца к началу за линейное время
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция ПоследнийИндекс(Элемент) Экспорт

	ТекущийСнимок = Снимок;

	Индекс = ТекущийСнимок.ВГраница();

	Пока Индекс >= 0 Цикл

		Если ТекущийСнимок[Индекс] = Элемент Тогда
			Возврат Индекс;
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Возврат -1;

КонецФункции

// Возвращает максимальный индекс списка
//
// Для пустого списка возвращает -1
//
//  Возвращаемое значение:
//   Число - Максимальный индекс списка
//
Функция ВГраница() Экспорт
	Возврат Снимок.ВГраница();
КонецФункции

// Выгружает элементы списка в массив
//
// Возвращается копия снимка списка, изменение полученного массива на список не влияет
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов списка
//
Функция ВМассив() Экспорт
	Возврат Новый Массив(Снимок);
КонецФункции

// Добавляет элемент в конец списка
//
// Список допускает дубликаты, поэтому элемент добавляется всегда.
// Изменение копирует все элементы списка и выполняется за линейное время
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Добавить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);
		Элементы.Добавить(Элемент);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Истина;

КонецФункции

// Добавляет в конец списка все элементы из переданной коллекции
//
// Элементы добавляются в порядке обхода переданной коллекции за одно копирование списка,
//  поэтому другие потоки видят либо список без новых элементов, либо со всеми сразу
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	ДобавляемыеЭлементы = Коллекция.ВМассив();

	Если ДобавляемыеЭлементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);

		Для Каждого Элемент Из ДобавляемыеЭлементы Цикл
			Элементы.Добавить(Элемент);
		КонецЦикла;

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Истина;

КонецФункции

// Удаляет все элементы списка
//
// Ранее созданные итераторы продолжают обходить прежние элементы
//
Процедура Очистить() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Опубликовать(Новый Массив);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет первое вхождение переданного элемента из списка
//
// Дубликаты элемента остаются в списке. Если элемент не найден, список не копируется
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён
//
Функция Удалить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		ИндексЭлемента = ИсходныйСнимок.Найти(Элемент);

		Если ИндексЭлемента <> Неопределено Тогда

			Элементы = Новый Массив(ИсходныйСнимок);
			Элементы.Удалить(ИндексЭлемента);

			Опубликовать(Элементы);

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ИндексЭлемента <> Неопределено;

КонецФункции

// Удаляет из списка элементы, которые содержатся в переданной коллекции
//
// Для каждого элемента переданной коллекции удаляется только первое его вхождение в список.
// Все удаления выполняются за одно копирование списка
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	УдаляемыеЭлементы = Коллекция.ВМассив();

	Если УдаляемыеЭлементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);

		Для Каждого Элемент Из УдаляемыеЭлементы Цикл

			ИндексЭлемента = Элементы.Найти(Элемент);

			Если ИндексЭлемента <> Неопределено Тогда
				Элементы.Удалить(ИндексЭлемента);
			КонецЕсли;

		КонецЦикла;

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет элементы списка для которых функция предикат вернёт Истина
//
// Удаляются все вхождения подходящих элементов за одно копирование списка.
// Блокировка удерживается на протяжении всего удаления, поэтому длительный предикат
//  задерживает другие изменяющие потоки, но не читающие.
// Изменение списка внутри предиката приведёт к исключению
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент списка
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    Список.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    Список.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Знач Предикат, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Предикат) = Тип("Строка") Тогда

		Предикат = Лямбда.Выражение(Предикат)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Предикат.Контекст(Контекст);
		Иначе
			Предикат.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Предикат = Предикат.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив;

		Для Каждого Элемент Из ИсходныйСнимок Цикл

			Если Не Предикат.Выполнить(Элемент) Тогда
				Элементы.Добавить(Элемент);
			КонецЕсли;

		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет из списка все элементы которые не содержатся в переданной коллекции
//
// Для каждого элемента списка выполняется проверка вхождения в переданную коллекцию
//  под блокировкой списка, все удаления выполняются за одно копирование списка
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив;

		Для Каждого Элемент Из ИсходныйСнимок Цикл

			Если Коллекция.Содержит(Элемент) Тогда
				Элементы.Добавить(Элемент);
			КонецЕсли;

		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Вставляет элемент в список по индексу
//
// Элементы, начиная с указанного индекса, сдвигаются вправо.
// Вызывает исключение, если индекс выходит за границы списка, в этом случае список не изменяется
//
// Параметры:
//   Индекс  - Число - Индекс, по которому будет вставлен элемент
//   Элемент - Произвольный - Вставляемый элемент
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Вставить(Индекс, Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);
		Элементы.Вставить(Индекс, Элемент);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Истина;

КонецФункции

// Вставляет все элементы из коллекции начиная с индекса
//
// Элементы вставляются в порядке обхода переданной коллекции за одно копирование списка,
//  поэтому другие потоки видят либо список без новых элементов, либо со всеми сразу
//
// Параметры:
//   Индекс    - Число - Индекс, начиная с которого будут вставлены элементы
//   Коллекция - ЧитаемаяКоллекция - Коллекция, из которой будут вставлены элементы
//
//  Возвращаемое значение:
//   Булево - Истина, если был вставлен хотя бы один элемент
//
Функция ВставитьВсе(Индекс, Коллекция) Экспорт

	ВставляемыеЭлементы = Коллекция.ВМассив();

	Если ВставляемыеЭлементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);

		Для Смещение = 0 По ВставляемыеЭлементы.ВГраница() Цикл
			Элементы.Вставить(Индекс + Смещение, ВставляемыеЭлементы[Смещение]);
		КонецЦикла;

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Истина;

КонецФункции

// Заменяет все элементы в списке через алгоритм
//
// Все замены выполняются за одно копирование списка, поэтому другие потоки видят
//  либо исходные элементы, либо только заменённые.
// Блокировка удерживается на протяжении всей замены, поэтому длительный алгоритм
//  задерживает другие изменяющие потоки, но не читающие.
// Изменение списка внутри алгоритма приведёт к исключению
//
// Параметры:
//   Алгоритм - Действие - Делегат на функцию с одним параметром, в которую передаётся
//    элемент списка, и которая возвращает новое значение элемента
//            - Строка - Лямбда выражение с одним параметром, в который передаётся
//    элемент списка, и которая возвращает новое значение элемента
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.ЗаменитьВсе("Элемент -> Элемент + 1");
//
//    Список.ЗаменитьВсе("Элемент -> Элемент + Соль", Новый Структура("Соль", 1));
//
Процедура ЗаменитьВсе(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Алгоритм) = Тип("Строка") Тогда

		Алгоритм = Лямбда.Выражение(Алгоритм)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Алгоритм.Контекст(Контекст);
		Иначе
			Алгоритм.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Алгоритм = Алгоритм.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив;

		Для Каждого Элемент Из ИсходныйСнимок Цикл
			Элементы.Добавить(Алгоритм.Выполнить(Элемент));
		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Сортирует список в соответствии с переданным алгоритмом
//
// Выполняется устойчивая сортировка копии элементов, порядок равных элементов сохраняется.
// Другие потоки видят либо исходный порядок, либо отсортированный, ранее созданные
//  итераторы продолжают обходить элементы в исходном порядке.
// Блокировка удерживается на протяжении всей сортировки, поэтому длительное сравнение
//  задерживает другие изменяющие потоки, но не читающие.
// Изменение списка внутри сравнения приведёт к исключению
//
// Параметры:
//   СравнениеЗначений - Действие - Делегат на функцию с двумя параметрами
//    в которую передаются 2 элемента списка, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//                     - Строка - Лямбда выражение с двумя параметрами
//    в которую передаются 2 элемента списка, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.Сортировать(СравнениеЗначений.ПрямойПорядок());
//
//    Список.Сортировать("Первый, Второй -> {
//        | Если Первый > Второй Тогда
//        |     Возврат 1;
//        | ИначеЕсли Второй > Первый Тогда
//        |     Возврат -1;
//        | Иначе
//        |     Возврат 0;
//        | КонецЕсли;
//        |}"
//    );
//
Процедура Сортировать(Знач СравнениеЗначений, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Массив(ИсходныйСнимок);

		Массивы.Сортировать(Элементы, СравнениеЗначений, Контекст);

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет элемент списка по индексу
//
// Элементы, следующие за удалённым, сдвигаются влево.
// Вызывает исключение, если индекс выходит за границы списка, в этом случае список не изменяется
//
// Параметры:
//   Индекс - Число - Индекс удаляемого элемента
//
//  Возвращаемое значение:
//   Произвольный - Значение которое было удалено
//
Функция УдалитьПоИндексу(Индекс) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ИсходныйСнимок.Получить(Индекс);

		Элементы = Новый Массив(ИсходныйСнимок);
		Элементы.Удалить(Индекс);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Устанавливает значение по индексу
//
// Вызывает исключение, если индекс выходит за границы списка, в этом случае список не изменяется
//
// Параметры:
//   Индекс   - Число - Индекс устанавливаемого элемента
//   Значение - Произвольный - Устанавливаемый элемент
//
//  Возвращаемое значение:
//   Произвольный - Значение которое было заменено
//
Функция Установить(Индекс, Значение) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Результат = ИсходныйСнимок.Получить(Индекс);

		Элементы = Новый Массив(ИсходныйСнимок);
		Элементы.Установить(Индекс, Значение);

		Опубликовать(Элементы);

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура Опубликовать(Элементы)
	Снимок = Новый ФиксированныйМассив(Элементы);
КонецПроцедуры

Процедура ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок)

	// Под блокировкой снимок может смениться только изнутри алгоритма, переданного
	//  в изменяющий метод, и публикация результата молча перетёрла бы это изменение
	Если Снимок <> ИсходныйСнимок Тогда
		ВызватьИсключение "Коллекция была изменена в процессе обхода";
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Потокобезопасный список с копированием при записи
//
// Элементы хранятся в неизменяемом снимке, каждое изменение копирует снимок, изменяет копию
//  и публикует её как новый снимок. Поэтому чтение и обход выполняются без блокировок
//  и никогда не видят список в промежуточном состоянии, а итераторы не становятся
//  невалидными при изменении списка - в том числе из других потоков.
// Получение элемента по индексу выполняется за постоянное время, поиск элемента
//  и любое изменение - за линейное время от размера списка.
// Изменения упорядочиваются блокировкой на самом списке, поэтому несколько изменений
//  можно выполнить атомарно, захватив `Новый БлокировкаРесурса(Список)`.
// Подходит для списков, которые читаются и обходятся значительно чаще, чем изменяются,
//  например списков подписчиков. При частых изменениях дешевле `СинхронизированныйСписок`
//
// Конструктор объекта
//
// Элементы переданной коллекции копируются в список в порядке её обхода,
//  дальнейшие изменения переданной коллекции в списке не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементами которой будет заполнен список
//
// Пример:
//    Подписчики = Новый СписокКопированиеПриЗаписи();
//
//    Список = Новый СписокКопированиеПриЗаписи(ДругойСписок);
//
&Обходимое
&Реализует("Список")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)

	Снимок     = Новый ФиксированныйМассив(Новый Массив);
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

	Если Коллекция <> Неопределено Тогда
		ДобавитьВсе(Коллекция);
	КонецЕсли;

КонецПроцедуры
