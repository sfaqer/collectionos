#Использовать fluent

#Использовать "../../../internal"

Перем Массив;        // Внутренний массив
Перем ЕстьИтераторы; // Признак того что из списка были созданы итераторы

// Возвращает итератор списка
//
// Возвращается двунаправленный итератор, поддерживающий изменение списка.
// С момента создания первого итератора список начинает оповещать итераторы о своих изменениях,
//  поэтому изменение списка в обход итератора делает ранее созданные итераторы невалидными
//
//  Возвращаемое значение:
//   СписокИтератор - Итератор списка
//
Функция Итератор() Экспорт

	ЕстьИтераторы = Истина;

	Возврат Новый СписокИтераторМассив(Массив, ЭтотОбъект);

КонецФункции

// Выполняет переданный алгоритм для каждого элемента списка
//
// Обход выполняется через итератор списка в порядке возрастания индексов,
//  изменение списка внутри алгоритма приведёт к исключению
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент списка
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
//    Список.ДляКаждого("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждого(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт
	Итератор().ДляКаждогоОставшегося(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанный элемент в списке
//
// Поиск элемента выполняется за линейное время
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат Индекс(Элемент) <> -1;
КонецФункции

// Проверяет что список содержит все элементы переданной коллекции
//
// Для каждого элемента переданной коллекции выполняется поиск по списку,
//  проверка прекращается на первом ненайденном элементе
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если список содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	Результат = Истина;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Не Содержит(Итератор.Следующий()) Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет что список пустой
//
//  Возвращаемое значение:
//   Булево - Истина, если список пуст
//
Функция Пусто() Экспорт
	Возврат Количество() = 0;
КонецФункции

// Возвращает процессор коллекции по элементам списка
//
// Процессор создаётся по копии элементов списка, поэтому дальнейшие изменения списка
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ПроцессорыКоллекций.ИзКоллекции(ВМассив());
КонецФункции

// Возвращает количество элементов списка
//
//  Возвращаемое значение:
//   Число - Количество элементов списка
//
Функция Количество() Экспорт
	Возврат Массив.Количество();
КонецФункции

// Получает элемент списка по индексу
//
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс - Число - Индекс, по которому требуется получить элемент списка
//
//  Возвращаемое значение:
//   Произвольный - Элемент списка по переданному индексу
//
Функция Получить(Индекс) Экспорт
	Возврат Массив.Получить(Индекс);
КонецФункции

// Возвращает индекс первого вхождения переданного элемента
//
// Поиск элемента выполняется за линейное время
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция Индекс(Элемент) Экспорт

	Результат = Массив.Найти(Элемент);

	Если Результат = Неопределено Тогда
		Результат = -1;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает индекс последнего вхождения переданного элемента
//
// Поиск выполняется перебором списка от конца к началу за линейное время
//
// Параметры:
//   Элемент - Произвольный - Элемент, индекс которого требуется получить
//
//  Возвращаемое значение:
//   Число - Индекс элемента списка, или -1 если список не содержит элемент
//
Функция ПоследнийИндекс(Элемент) Экспорт
	
	Индекс = ВГраница();

	Пока Индекс >= 0 Цикл

		Если Получить(Индекс) = Элемент Тогда
			Возврат Индекс;
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Возврат -1;

КонецФункции

// Возвращает максимальный индекс списка
//
// Для пустого списка возвращает -1
//
//  Возвращаемое значение:
//   Число - Максимальный индекс списка
//
Функция ВГраница() Экспорт
	Возврат Массив.ВГраница();
КонецФункции

// Выгружает элементы списка в массив
//
// Возвращается копия элементов списка, изменение полученного массива на список не влияет
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов списка
//
Функция ВМассив() Экспорт
	Возврат Массивы.Скопировать(Массив);
КонецФункции

// Добавляет элемент в конец списка
//
// Список допускает дубликаты, поэтому элемент добавляется всегда
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Добавить(Элемент) Экспорт

	Массив.Добавить(Элемент);

	ОповеститьОбИзмененииКоллекции();

	Возврат Истина;

КонецФункции

// Добавляет в конец списка все элементы из переданной коллекции
//
// Элементы добавляются в порядке обхода переданной коллекции
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	БылДобавленХотяБыОдинЭлемент = Ложь;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		БылДобавленХотяБыОдинЭлемент = Добавить(Итератор.Следующий())
			Или БылДобавленХотяБыОдинЭлемент;

	КонецЦикла;

	Возврат БылДобавленХотяБыОдинЭлемент;

КонецФункции

// Удаляет все элементы списка
//
Процедура Очистить() Экспорт
	
	Массив.Очистить();

	ОповеститьОбИзмененииКоллекции();

КонецПроцедуры

// Удаляет первое вхождение переданного элемента из списка
//
// Дубликаты элемента остаются в списке
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён
//
Функция Удалить(Элемент) Экспорт
	
	ИндексЭлемента = Индекс(Элемент);

	Если ИндексЭлемента <> -1 Тогда
	
		Массив.Удалить(ИндексЭлемента);
		ОповеститьОбИзмененииКоллекции();

		Возврат Истина;
	
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Удаляет из списка элементы, которые содержатся в переданной коллекции
//
// Для каждого элемента переданной коллекции удаляется только первое его вхождение в список
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		БылУдаленХотяБыОдинЭлемент = Удалить(Итератор.Следующий()) 
			Или БылУдаленХотяБыОдинЭлемент;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет элементы списка для которых функция предикат вернёт Истина
//
// Удаление выполняется за один проход через итератор списка, поэтому удаляются
//  все вхождения подходящих элементов
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент списка
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент списка
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    Список.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    Список.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Знач Предикат, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Предикат) = Тип("Строка") Тогда

		Предикат = Лямбда.Выражение(Предикат)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Предикат.Контекст(Контекст);
		Иначе
			Предикат.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Предикат = Предикат.ВДействие();

	КонецЕсли;

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Предикат.Выполнить(Итератор.Следующий()) Тогда
			
			Итератор.Удалить();

			БылУдаленХотяБыОдинЭлемент = Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет из списка все элементы которые не содержатся в переданной коллекции
//
// Для каждого элемента списка выполняется проверка вхождения в переданную коллекцию
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Не Коллекция.Содержит(Итератор.Следующий()) Тогда
			
			Итератор.Удалить();

			БылУдаленХотяБыОдинЭлемент = Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Вставляет элемент в список по индексу
//
// Элементы, начиная с указанного индекса, сдвигаются вправо.
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс  - Число - Индекс, по которому будет вставлен элемент
//   Элемент - Произвольный - Вставляемый элемент
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Вставить(Индекс, Элемент) Экспорт
	
	Массив.Вставить(Индекс, Элемент);

	ОповеститьОбИзмененииКоллекции();

	Возврат Истина;

КонецФункции

// Вставляет все элементы из коллекции начиная с индекса
//
// Элементы вставляются в порядке обхода переданной коллекции, сохраняя её порядок
//
// Параметры:
//   Индекс    - Число - Индекс, начиная с которого будут вставлены элементы
//   Коллекция - ЧитаемаяКоллекция - Коллекция, из которой будут вставлены элементы
//
//  Возвращаемое значение:
//   Булево - Истина, если был вставлен хотя бы один элемент
//
Функция ВставитьВсе(Индекс, Коллекция) Экспорт

	БылВставленХотяБыОдинЭлемент = Ложь;

	СчетчикВставленныхЭлементов = 0;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл
		
		Вставить(Индекс + СчетчикВставленныхЭлементов, Итератор.Следующий());

		БылВставленХотяБыОдинЭлемент = Истина;
		СчетчикВставленныхЭлементов  = СчетчикВставленныхЭлементов + 1;

	КонецЦикла;

	Возврат БылВставленХотяБыОдинЭлемент;

КонецФункции

// Заменяет все элементы в списке через алгоритм
//
// Элементы заменяются по индексам в порядке возрастания, каждая замена
//  делает ранее созданные итераторы списка невалидными
//
// Параметры:
//   Алгоритм - Действие - Делегат на функцию с одним параметром, в которую передаётся
//    элемент списка, и которая возвращает новое значение элемента
//            - Строка - Лямбда выражение с одним параметром, в который передаётся
//    элемент списка, и которая возвращает новое значение элемента
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.ЗаменитьВсе("Элемент -> Элемент + 1");
//
//    Список.ЗаменитьВсе("Элемент -> Элемент + Соль", Новый Структура("Соль", 1));
//
Процедура ЗаменитьВсе(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Алгоритм) = Тип("Строка") Тогда

		Алгоритм = Лямбда.Выражение(Алгоритм)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Алгоритм.Контекст(Контекст);
		Иначе
			Алгоритм.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Алгоритм = Алгоритм.ВДействие();

	КонецЕсли;

	Для Индекс = 0 По ВГраница() Цикл
		Установить(Индекс, Алгоритм.Выполнить(Получить(Индекс)));
	КонецЦикла;

КонецПроцедуры

// Сортирует список в соответствии с переданным алгоритмом
//
// Выполняется устойчивая сортировка на месте, порядок равных элементов сохраняется.
// В отличие от остальных изменяющих методов, сортировка не оповещает ранее созданные
//  итераторы списка об изменении, поэтому продолжать обход после сортировки не следует
//
// Параметры:
//   СравнениеЗначений - Действие - Делегат на функцию с двумя параметрами
//    в которую передаются 2 элемента списка, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//                     - Строка - Лямбда выражение с двумя параметрами
//    в которую передаются 2 элемента списка, и которая возвращает число
//      1 - Если первый элемент больше,
//     -1 - Если второй элемент больше,
//      0 - Если элементы равны
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Список.Сортировать(СравнениеЗначений.ПрямойПорядок());
//
//    Список.Сортировать("Первый, Второй -> {
//        | Если Первый > Второй Тогда
//        |     Возврат 1;
//        | ИначеЕсли Второй > Первый Тогда
//        |     Возврат -1;
//        | Иначе
//        |     Возврат 0;
//        | КонецЕсли;
//        |}"
//    );
//
Процедура Сортировать(Знач СравнениеЗначений, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат;
	КонецЕсли;

	Массивы.Сортировать(Массив, СравнениеЗначений, Контекст);

КонецПроцедуры

// Удаляет элемент списка по индексу
//
// Элементы, следующие за удалённым, сдвигаются влево.
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс - Число - Индекс удаляемого элемента
//
//  Возвращаемое значение:
//   Произвольный - Значение которое было удалено
//
Функция УдалитьПоИндексу(Индекс) Экспорт
	
	Результат = Получить(Индекс);

	Массив.Удалить(Индекс);

	ОповеститьОбИзмененииКоллекции();
	
	Возврат Результат;

КонецФункции

// Устанавливает значение по индексу
//
// Вызывает исключение, если индекс выходит за границы списка
//
// Параметры:
//   Индекс   - Число - Индекс устанавливаемого элемента
//   Значение - Произвольный - Устанавливаемый элемент
//
//  Возвращаемое значение:
//   Произвольный - Значение которое было заменено
//
Функция Установить(Индекс, Значение) Экспорт

	Результат = Получить(Индекс);

	Массив.Установить(Индекс, Значение);
	
	ОповеститьОбИзмененииКоллекции();

	Возврат Результат;

КонецФункции

Процедура ОповеститьОбИзмененииКоллекции()
	
	Если ЕстьИтераторы Тогда
		ВызватьСобытие("КоллекцияМодифицирована", Новый Массив);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Список, реализованный на базе массива
//
// Допускает дубликаты элементов и сохраняет порядок добавления.
// Получение и установка элемента по индексу выполняются за постоянное время,
//  поиск элемента, вставка и удаление в середине списка - за линейное время.
// Список не является потокобезопасным, для одновременной работы из нескольких потоков
//  следует использовать `СинхронизированныйСписок`
//
// Конструктор объекта
//
// Элементы переданной коллекции копируются в список в порядке её обхода,
//  дальнейшие изменения переданной коллекции в списке не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементами которой будет заполнен список
//
// Пример:
//    Список = Новый СписокМассив();
//
//    Список = Новый СписокМассив(ДругойСписок);
//
&Обходимое
&Реализует("Список")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)

	Массив        = Новый Массив;
	ЕстьИтераторы = Ложь;

	Если Коллекция <> Неопределено Тогда
		ДобавитьВсе(Коллекция);
	КонецЕсли;

КонецПроцедуры
