#Использовать fluent
#Использовать optional
#Использовать reflector

#Использовать "../../../internal"

Перем Очередь;              // Внутренняя приоритетная очередь
Перем ИнтерфейсОтложенный;  // Интерфейс
Перем Блокировка;           // Блокировка на синхронизированном представлении внутренней очереди

// Возвращает итератор очереди
//
// Обход выполняется по всем элементам очереди, в том числе по тем, задержка которых
//  ещё не истекла. Итератор не захватывает блокировку очереди, поэтому изменение очереди
//  из другого потока во время обхода приведёт к исключению
//
//  Возвращаемое значение:
//   Итератор - Итератор очереди
//
Функция Итератор() Экспорт
	Возврат Очередь.Итератор();
КонецФункции

// Выполняет переданный алгоритм для каждого элемента очереди
//
// Обход выполняется по всем элементам очереди, в том числе по тем, задержка которых
//  ещё не истекла, элементы при этом не извлекаются.
// Обход не захватывает блокировку очереди
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент очереди
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент очереди
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Очередь.ДляКаждого("Элемент -> Сообщить(Элемент.Задержка())");
//
Процедура ДляКаждого(Знач Алгоритм, Контекст = Неопределено) Экспорт
	Очередь.ДляКаждого(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанный элемент в очереди
//
// Проверяются все элементы очереди, в том числе те, задержка которых ещё не истекла
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат Очередь.Содержит(Элемент);
КонецФункции

// Проверяет что очередь содержит все элементы переданной коллекции
//
// Проверяются все элементы очереди, в том числе те, задержка которых ещё не истекла
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт
	Возврат Очередь.СодержитВсе(Коллекция);
КонецФункции

// Проверяет что очередь пустая
//
// Очередь считается пустой только если в ней нет элементов, наличие элементов
//  с неистекшей задержкой делает очередь непустой
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь пуста
//
Функция Пусто() Экспорт
	Возврат Очередь.Пусто();
КонецФункции

// Возвращает процессор коллекции по элементам очереди
//
// Процессор создаётся по копии всех элементов очереди, в том числе тех,
//  задержка которых ещё не истекла
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат Очередь.ПроцессорКоллекции();
КонецФункции

// Возвращает количество элементов очереди
//
// Учитываются все элементы очереди, в том числе те, задержка которых ещё не истекла
//
//  Возвращаемое значение:
//   Число - Количество элементов очереди
//
Функция Количество() Экспорт
	Возврат Очередь.Количество();
КонецФункции

// Выгружает элементы очереди в массив
//
// Выгружаются все элементы очереди, в том числе те, задержка которых ещё не истекла
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов очереди
//
Функция ВМассив() Экспорт
	Возврат Очередь.ВМассив();
КонецФункции

// Возвращает, но не удаляет элемент очереди с ближайшим сроком готовности,
//  если его задержка истекла
//
// Для непустой очереди возвращает пустой опциональный, если задержка ближайшего элемента
//  ещё не истекла - остальные элементы очереди готовыми быть не могут
//
//  Возвращаемое значение:
//   Опциональный - Готовый элемент очереди, `Опциональные.Пустой()` если очередь пуста
//    или срок ближайшего элемента ещё не наступил
//
Функция Подсмотреть() Экспорт

	Возврат Очередь.Подсмотреть()
		.Развернуть("(Отложенный) -> ?(Отложенный.Задержка() <= 0, Новый Опциональный(Отложенный), Опциональные.Пустой());");

КонецФункции

// Помещает отложенный элемент в очередь
//
// Метод эквивалентен методу `Положить` и реализован для совместимости с интерфейсом коллекции
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент, обязан иметь метод `Задержка`
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Добавить(Элемент) Экспорт
	Возврат Положить(Элемент);
КонецФункции

// Помещает в очередь все элементы из переданной коллекции
//
// Элементы помещаются под общей блокировкой очереди, то есть атомарно относительно
//  других потоков.
// Вызывает исключение, если коллекция содержит Неопределено или элемент без метода `Задержка`,
//  при этом ранее помещённые элементы остаются в очереди
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка

		БылДобавленХотяБыОдинЭлемент = Ложь;

		Итератор = Коллекция.Итератор();

		Пока Итератор.ЕстьСледующий() Цикл

			БылДобавленХотяБыОдинЭлемент = Добавить(Итератор.Следующий())
				Или БылДобавленХотяБыОдинЭлемент;

		КонецЦикла;

		Блокировка.Разблокировать();

	Исключение

		Блокировка.Разблокировать();
		ВызватьИсключение;

	КонецПопытки;

	Возврат БылДобавленХотяБыОдинЭлемент;

КонецФункции

// Удаляет все элементы очереди
//
Процедура Очистить() Экспорт
	Очередь.Очистить();
КонецПроцедуры

// Удаляет переданный элемент из очереди
//
// Элемент удаляется независимо от того, истекла его задержка или нет
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён
//
Функция Удалить(Элемент) Экспорт
	Возврат Очередь.Удалить(Элемент);
КонецФункции

// Удаляет из очереди элементы, которые содержатся в переданной коллекции
//
// Элементы удаляются независимо от того, истекла их задержка или нет
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт
	Возврат Очередь.УдалитьВсе(Коллекция);
КонецФункции

// Удаляет элементы очереди для которых функция предикат вернёт Истина
//
// Предикат вызывается для всех элементов очереди, в том числе для тех,
//  задержка которых ещё не истекла
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент очереди
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент очереди
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    Очередь.УдалитьЕсли("(Элемент) -> Элемент.Задержка() > 1000");
//
Функция УдалитьЕсли(Предикат, Контекст = Неопределено) Экспорт
	Возврат Очередь.УдалитьЕсли(Предикат, Контекст);
КонецФункции

// Удаляет из очереди все элементы которые не содержатся в переданной коллекции
//
// Элементы удаляются независимо от того, истекла их задержка или нет
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт
	Возврат Очередь.СохранитьВсе(Коллекция);
КонецФункции

// Помещает отложенный элемент в очередь
//
// Место элемента в очереди определяется сравнением задержек элементов.
// Вызывает исключение при попытке поместить Неопределено или элемент,
//  у которого нет метода `Задержка`
//
// Параметры:
//  Элемент - Произвольный - Элемент, который требуется поместить в очередь,
//   обязан иметь метод `Задержка`, возвращающий количество миллисекунд до готовности элемента
//
//  Возвращаемое значение:
//   Булево - Всегда Истина
//
Функция Положить(Элемент) Экспорт

	Если Элемент = Неопределено Тогда
		ВызватьИсключение "Очередь не может содержать Неопределено";
	КонецЕсли;

	_ = Новый РефлекторОбъекта(Элемент) // BSLLS:UnusedLocalVariable-off
		.РеализуетИнтерфейс(ИнтерфейсОтложенный, Истина);
	Возврат Очередь.Положить(Элемент);

КонецФункции

// Возвращает и удаляет элемент очереди с ближайшим сроком готовности,
//  если его задержка истекла
//
// Если готового элемента нет, метод ждёт его появления до истечения таймаута,
//  опрашивая очередь каждые 100 миллисекунд, поэтому элемент может быть возвращён
//  позже момента своей готовности.
// Ожидание не блокирует другие потоки - на время паузы блокировка очереди отпускается
//
// Параметры:
//   Таймаут - Число - Количество миллисекунд, в течение которых требуется ждать готовый элемент,
//    по умолчанию ожидание не выполняется
//
//  Возвращаемое значение:
//   Опциональный - Готовый элемент очереди, `Опциональные.Пустой()` если за время
//    ожидания готовый элемент не появился
//
Функция Взять(Знач Таймаут = 0) Экспорт

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Таймаут;
	Результат = Неопределено;

	Пока Истина Цикл

		Блокировка.Заблокировать();

		Попытка

			Элемент = Очередь.Подсмотреть();

			Если Элемент.Фильтровать("Элемент -> Элемент.Задержка() <= 0 ").СодержитЗначение() Тогда
				Результат = Очередь.Взять();
			КонецЕсли;

		Исключение

			Блокировка.Разблокировать();
			ВызватьИсключение;

		КонецПопытки;

		Блокировка.Разблокировать();

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Конец И Результат = Неопределено Тогда
			Результат = Опциональные.Пустой();
		КонецЕсли;

		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Потокобезопасная очередь отложенных элементов
//
// Элементы очереди обязаны иметь метод `Задержка`, возвращающий количество миллисекунд,
//  оставшееся до момента, когда элемент можно извлечь, наличие метода проверяется
//  при помещении элемента в очередь.
// Извлечь можно только элемент, у которого задержка истекла, поэтому для непустой очереди
//  методы `Подсмотреть` и `Взять` могут возвращать пустой опциональный.
// Класс является частным случаем приоритетной очереди - элементы упорядочены по возрастанию
//  задержки, поэтому в голове очереди всегда находится элемент с ближайшим сроком готовности.
// Состояние очереди защищено блокировкой, поэтому очередью можно пользоваться
//  из нескольких потоков.
// Обход очереди итератором и методом `ДляКаждого` не синхронизирован
//
// Конструктор объекта
//
// Элементы переданной коллекции помещаются в очередь, каждый из них обязан иметь
//  метод `Задержка`, дальнейшие изменения переданной коллекции в очереди не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементами которой будет заполнена очередь
//
// Пример:
//    Очередь = Новый ОчередьОтложенных();
//
//    Очередь.Положить(Новый ОтложеннаяЗадача(1000, Задача));
//
//    Задача = Очередь.Взять(5000);
//
&Обходимое
&Реализует("Очередь")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)

	ИнтерфейсОтложенный = Новый ИнтерфейсОбъекта()
		.Ф("Задержка");

	Очередь = Новый СинхронизированнаяОчередь(
		Новый ПриоритетнаяОчередь(
			"(Первый, Второй) -> {
			|	Возврат СравнениеЗначений
			|		.ПрямойПорядок()
			|		.Выполнить(
			|			Первый.Задержка(),
			|			Второй.Задержка()
			|		);
			|}"
		)
	);

	Блокировка = Новый БлокировкаРесурса(Очередь);

	Если Коллекция <> Неопределено Тогда
		ДобавитьВсе(Коллекция);
	КонецЕсли;

КонецПроцедуры
