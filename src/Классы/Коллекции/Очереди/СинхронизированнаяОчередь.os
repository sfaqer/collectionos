#Использовать "../../../internal"

Перем ВнутренняяОчередь;  // Оригинальная очередь
Перем Блокировка;         // Блокировка для синхронизации доступа

// Возвращает итератор обёрнутой очереди
//
// Итератор не захватывает блокировку, поэтому обход требует внешней синхронизации,
//  изменение очереди из другого потока во время обхода приводит к исключению
//
//  Возвращаемое значение:
//   Итератор - Итератор очереди
//
Функция Итератор() Экспорт
	Возврат ВнутренняяОчередь.Итератор();
КонецФункции

// Выполняет переданный алгоритм для каждого элемента очереди
//
// Блокировка удерживается на протяжении всего обхода, поэтому длительный алгоритм
//  блокирует остальные потоки
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент очереди
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент очереди
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    очередь.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	
	Блокировка.Заблокировать();

	Попытка
		ВнутренняяОчередь.ДляКаждого(Алгоритм, Контекст);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Проверяет содержится ли указанный элемент в очереди
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Содержит(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Проверяет что очередь содержит все элементы переданной коллекции
//
// Проверка выполняется целиком под блокировкой
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.СодержитВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Проверяет что очередь пустая
//
//  Возвращаемое значение:
//   Булево - Истина, если очередь пуста
//
Функция Пусто() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Пусто();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;
	
КонецФункции

// Возвращает процессор коллекции по элементам обёрнутой очереди
//
// В отличие от остальных методов, вызов выполняется без блокировки
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ВнутренняяОчередь.ПроцессорКоллекции();
КонецФункции

// Возвращает количество элементов очереди
//
//  Возвращаемое значение:
//   Число - Количество элементов очереди
//
Функция Количество() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Выгружает элементы очереди в массив
//
// Выгрузка выполняется под блокировкой, поэтому полученный массив является
//  согласованным снимком очереди
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов очереди
//
Функция ВМассив() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.ВМассив();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает, но не удаляет первый элемент очереди
//
// Метод не ждёт появления элементов, к моменту возврата элемент уже может быть
//  извлечён другим потоком
//
//  Возвращаемое значение:
//   Опциональный - Первый элемент очереди, `Опциональные.Пустой()` если очередь пуста
//
Функция Подсмотреть() Экспорт
	
	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Подсмотреть();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Помещает элемент в очередь
//
// Метод эквивалентен методу `Положить` и реализован для совместимости с интерфейсом коллекции
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент помещён в очередь
//
Функция Добавить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Добавить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Добавляет все элементы из переданной коллекции
//
// Элементы добавляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.ДобавитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы очереди
//
Процедура Очистить() Экспорт

	Блокировка.Заблокировать();

	Попытка
		ВнутренняяОчередь.Очистить();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет переданный элемент из очереди
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён
//
Функция Удалить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Удалить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы которые содержатся в переданной коллекции
//
// Элементы удаляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.УдалитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет элементы для которых функция предикат вернёт Истина
//
// Блокировка удерживается на протяжении всего удаления, поэтому длительный предикат
//  блокирует остальные потоки
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент очереди
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент очереди
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    очередь.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    очередь.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Предикат, Контекст = Неопределено) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.УдалитьЕсли(Предикат, Контекст);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы которые не содержатся в переданной коллекции
//
// Элементы удаляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.СохранитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Помещает элемент в очередь
//
// Ограничения на помещаемый элемент определяются обёрнутой очередью
//
// Параметры:
//  Элемент - Произвольный - Элемент, который требуется поместить в очередь
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был помещён в очередь
//
Функция Положить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутренняяОчередь.Положить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Возвращает и удаляет первый элемент очереди
//
// Если очередь пуста, метод ждёт появления элемента до истечения таймаута,
//  опрашивая очередь каждые 100 миллисекунд, поэтому элемент может быть возвращён
//  позже момента его появления.
// Ожидание не блокирует другие потоки - на время паузы блокировка очереди отпускается
//
// Параметры:
//   Таймаут - Число - Количество миллисекунд, в течение которых требуется ждать элемент,
//    по умолчанию ожидание не выполняется
//
//  Возвращаемое значение:
//   Опциональный - Первый элемент очереди, `Опциональные.Пустой()` если за время
//    ожидания элемент не появился
//
Функция Взять(Таймаут = 0) Экспорт

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Таймаут;
	Результат = Неопределено;

	Пока Истина Цикл

		Блокировка.Заблокировать();

		Попытка
			Результат = ВнутренняяОчередь.Взять();
		Исключение
			Блокировка.Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

		Блокировка.Разблокировать();

		ВремяВышло = ТекущаяУниверсальнаяДатаВМиллисекундах() >= Конец;

		Если Результат.СодержитЗначение() Или ВремяВышло Тогда
			Возврат Результат;
		КонецЕсли;

		Приостановить(100);

	КонецЦикла;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Потокобезопасное представление очереди
//
// Оборачивает переданную очередь и выполняет каждый её метод под блокировкой,
//  поэтому отдельный вызов метода атомарен относительно других потоков.
// В отличие от остальных синхронизированных представлений, метод `Взять` умеет ждать
//  появления элемента, что позволяет использовать представление как канал передачи
//  элементов между потоками.
// Обёрнутая очередь не копируется, поэтому изменения, выполненные напрямую через неё,
//  видны в представлении, но защиту блокировкой уже не получают - работать
//  с очередью следует только через представление.
// Обход итератором не синхронизирован
//
// Конструктор объекта
//
// Переданная очередь не копируется, представление работает поверх неё
//
// Параметры:
//   Очередь - Очередь - Оборачиваемая очередь
//
// Пример:
//    Очередь = Новый СинхронизированнаяОчередь(Новый ОчередьМассив());
//
//    Элемент = Очередь.Взять(5000);
//
&Обходимое
&Реализует("Очередь")
Процедура ПриСозданииОбъекта(Очередь)

	ВнутренняяОчередь  = Очередь;
	Блокировка         = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
