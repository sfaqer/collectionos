#Использовать fluent
#Использовать lambdas

#Использовать "../../../internal"

Перем Снимок;       // Текущий снимок множества, после публикации не изменяется
Перем КешЭлементов; // Массив элементов снимка для итераторов и выгрузки, строится при первом обходе
Перем Блокировка;   // Блокировка, упорядочивающая изменения множества

// Возвращает итератор множества
//
// Итератор обходит снимок элементов, сформированный в момент его создания. Изменения
//  множества после создания итератора в обходе не видны и исключения не вызывают.
// Первый итератор после изменения множества формирует массив элементов снимка за линейное
//  время, следующие итераторы до очередного изменения переиспользуют его и создаются
//  за постоянное время. Удаление элементов через итератор не поддерживается
//
//  Возвращаемое значение:
//   Итератор - Итератор по снимку множества
//
Функция Итератор() Экспорт
	Возврат Новый ИтераторСнимок(ЭлементыСнимка());
КонецФункции

// Выполняет переданный алгоритм для каждого элемента множества
//
// Обход выполняется по снимку множества без блокировки и без копирования элементов,
//  изменять множество внутри алгоритма допустимо, но на обход это не влияет
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Множество.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
//    Множество.ДляКаждого("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждого(Знач Алгоритм, Знач Контекст = Неопределено) Экспорт

	ТекущийСнимок = Снимок;

	Если ТекущийСнимок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Алгоритм) = Тип("Строка") Тогда

		Алгоритм = Лямбда.Выражение(Алгоритм)
			.Интерфейс(ФункциональныеИнтерфейсы.УниПроцедура());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Алгоритм.Контекст(Контекст);
		Иначе
			Алгоритм.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Алгоритм = Алгоритм.ВДействие();

	КонецЕсли;

	Для Каждого КлючИЗначение Из ТекущийСнимок Цикл
		Алгоритм.Выполнить(КлючИЗначение.Ключ);
	КонецЦикла;

КонецПроцедуры

// Проверяет содержится ли указанный элемент в множестве
//
// Проверка выполняется по снимку множества без блокировки за постоянное время
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат Снимок.Получить(Элемент) <> Неопределено;
КонецФункции

// Проверяет что множество содержит все элементы переданной коллекции
//
// Все проверки выполняются по одному снимку множества, поэтому результат согласован
//  даже при одновременном изменении множества из других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	ТекущийСнимок = Снимок;

	Результат = Истина;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если ТекущийСнимок.Получить(Итератор.Следующий()) = Неопределено Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет что множество пустое
//
//  Возвращаемое значение:
//   Булево - Истина, если множество пусто
//
Функция Пусто() Экспорт
	Возврат Снимок.Количество() = 0;
КонецФункции

// Возвращает процессор коллекции по элементам множества
//
// Процессор создаётся по копии снимка множества, поэтому дальнейшие изменения множества
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ПроцессорыКоллекций.ИзКоллекции(ВМассив());
КонецФункции

// Возвращает количество элементов множества
//
//  Возвращаемое значение:
//   Число - Количество элементов множества
//
Функция Количество() Экспорт
	Возврат Снимок.Количество();
КонецФункции

// Выгружает элементы множества в массив
//
// Порядок элементов в массиве соответствует порядку обхода множества, изменение полученного
//  массива на множество не влияет. Как и итератор, переиспользует массив элементов снимка
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов множества
//
Функция ВМассив() Экспорт
	Возврат Новый Массив(ЭлементыСнимка());
КонецФункции

// Добавляет элемент в множество
//
// Если элемент уже содержится в множестве, множество не изменяется и блокировка
//  не захватывается, иначе множество копируется за линейное время
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент добавлен, Ложь если он уже содержался в множестве
//
Функция Добавить(Элемент) Экспорт

	Если Содержит(Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		ЭлементДобавлен = ИсходныйСнимок.Получить(Элемент) = Неопределено;

		Если ЭлементДобавлен Тогда

			Элементы = Новый Соответствие(ИсходныйСнимок);
			Элементы.Вставить(Элемент, Истина);

			Опубликовать(Элементы);

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ЭлементДобавлен;

КонецФункции

// Добавляет в множество все элементы из переданной коллекции
//
// Элементы, которые уже содержатся в множестве, пропускаются. Все элементы добавляются
//  за одно копирование множества, поэтому другие потоки видят либо множество
//  без новых элементов, либо со всеми сразу
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	ДобавляемыеЭлементы = Коллекция.ВМассив();

	Если ДобавляемыеЭлементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Соответствие(ИсходныйСнимок);

		Для Каждого Элемент Из ДобавляемыеЭлементы Цикл
			Элементы.Вставить(Элемент, Истина);
		КонецЦикла;

		БылДобавленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылДобавленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылДобавленХотяБыОдинЭлемент;

КонецФункции

// Удаляет все элементы множества
//
// Ранее созданные итераторы продолжают обходить прежние элементы
//
Процедура Очистить() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Опубликовать(Новый Соответствие);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет переданный элемент из множества
//
// Если множество не содержит элемент, оно не изменяется и блокировка не захватывается,
//  иначе множество копируется за линейное время
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён, Ложь если множество его не содержало
//
Функция Удалить(Элемент) Экспорт

	Если Не Содержит(Элемент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		ЭлементУдален = ИсходныйСнимок.Получить(Элемент) <> Неопределено;

		Если ЭлементУдален Тогда

			Элементы = Новый Соответствие(ИсходныйСнимок);
			Элементы.Удалить(Элемент);

			Опубликовать(Элементы);

		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат ЭлементУдален;

КонецФункции

// Удаляет из множества все элементы которые содержатся в переданной коллекции
//
// Все удаления выполняются за одно копирование множества
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	УдаляемыеЭлементы = Коллекция.ВМассив();

	Если УдаляемыеЭлементы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Соответствие(ИсходныйСнимок);

		Для Каждого Элемент Из УдаляемыеЭлементы Цикл
			Элементы.Удалить(Элемент);
		КонецЦикла;

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет элементы множества для которых функция предикат вернёт Истина
//
// Все удаления выполняются за одно копирование множества.
// Блокировка удерживается на протяжении всего удаления, поэтому длительный предикат
//  задерживает другие изменяющие потоки, но не читающие.
// Изменение множества внутри предиката приведёт к исключению
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    Множество.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    Множество.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Знач Предикат, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Предикат) = Тип("Строка") Тогда

		Предикат = Лямбда.Выражение(Предикат)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Предикат.Контекст(Контекст);
		Иначе
			Предикат.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Предикат = Предикат.ВДействие();

	КонецЕсли;

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Соответствие;

		Для Каждого КлючИЗначение Из ИсходныйСнимок Цикл

			Если Не Предикат.Выполнить(КлючИЗначение.Ключ) Тогда
				Элементы.Вставить(КлючИЗначение.Ключ, Истина);
			КонецЕсли;

		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет из множества все элементы которые не содержатся в переданной коллекции
//
// Для каждого элемента множества выполняется проверка вхождения в переданную коллекцию
//  под блокировкой множества, поэтому сложность операции определяется реализацией
//  переданной коллекции. Все удаления выполняются за одно копирование множества
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка

		ИсходныйСнимок = Снимок;

		Элементы = Новый Соответствие;

		Для Каждого КлючИЗначение Из ИсходныйСнимок Цикл

			Если Коллекция.Содержит(КлючИЗначение.Ключ) Тогда
				Элементы.Вставить(КлючИЗначение.Ключ, Истина);
			КонецЕсли;

		КонецЦикла;

		ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок);

		БылУдаленХотяБыОдинЭлемент = Элементы.Количество() <> ИсходныйСнимок.Количество();

		Если БылУдаленХотяБыОдинЭлемент Тогда
			Опубликовать(Элементы);
		КонецЕсли;

	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

Функция ЭлементыСнимка()

	ТекущийСнимок = Снимок;
	Кеш           = КешЭлементов;

	Если Кеш <> Неопределено И Кеш.Снимок = ТекущийСнимок Тогда
		Возврат Кеш.Элементы;
	КонецЕсли;

	Элементы = Новый Массив;

	Для Каждого КлючИЗначение Из ТекущийСнимок Цикл
		Элементы.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Элементы = Новый ФиксированныйМассив(Элементы);

	// Гонка между потоками безвредна: массив согласован со снимком, по которому построен,
	//  а кеш устаревшего снимка просто не будет использован и не удержит его надолго
	Если Снимок = ТекущийСнимок Тогда
		КешЭлементов = Новый ФиксированнаяСтруктура("Снимок, Элементы", ТекущийСнимок, Элементы);
	КонецЕсли;

	Возврат Элементы;

КонецФункции

Процедура Опубликовать(Элементы)

	Снимок       = Новый ФиксированноеСоответствие(Элементы);
	КешЭлементов = Неопределено;

КонецПроцедуры

Процедура ПроверитьОтсутствиеВложенныхИзменений(ИсходныйСнимок)

	// Под блокировкой снимок может смениться только изнутри алгоритма, переданного
	//  в изменяющий метод, и публикация результата молча перетёрла бы это изменение
	Если Снимок <> ИсходныйСнимок Тогда
		ВызватьИсключение "Коллекция была изменена в процессе обхода";
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Потокобезопасное множество с копированием при записи
//
// Элементы хранятся в неизменяемом снимке на базе соответствия, каждое изменение копирует
//  снимок, изменяет копию и публикует её как новый снимок. Поэтому чтение и обход выполняются
//  без блокировок и никогда не видят множество в промежуточном состоянии, а итераторы
//  не становятся невалидными при изменении множества - в том числе из других потоков.
// Проверка вхождения выполняется за постоянное время, элементы сравниваются по правилам
//  соответствия платформы. Порядок обхода определяется порядком элементов во внутреннем
//  соответствии и не обязан совпадать с порядком добавления.
// Любое изменение выполняется за линейное время от размера множества, но добавление уже
//  содержащегося элемента и удаление отсутствующего не копируют снимок и не захватывают
//  блокировку. Массив элементов для итераторов и выгрузки строится один раз на каждый снимок,
//  поэтому при редких изменениях обход начинается за постоянное время.
// Изменения упорядочиваются блокировкой на самом множестве, поэтому несколько изменений
//  можно выполнить атомарно, захватив `Новый БлокировкаРесурса(Множество)`.
// Подходит для множеств, которые читаются значительно чаще, чем изменяются.
//  При частых изменениях дешевле `СинхронизированноеМножество`
//
// Конструктор объекта
//
// Элементы переданной коллекции копируются в множество, дубликаты отбрасываются,
//  дальнейшие изменения переданной коллекции в множестве не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементами которой будет заполнено множество
//
// Пример:
//    Множество = Новый МножествоКопированиеПриЗаписи();
//
//    Множество = Новый МножествоКопированиеПриЗаписи(Список);
//
&Обходимое
&Реализует("Множество")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)

	Снимок       = Новый ФиксированноеСоответствие(Новый Соответствие);
	КешЭлементов = Неопределено;
	Блокировка   = Новый БлокировкаРесурса(ЭтотОбъект);

	Если Коллекция <> Неопределено Тогда
		ДобавитьВсе(Коллекция);
	КонецЕсли;

КонецПроцедуры
