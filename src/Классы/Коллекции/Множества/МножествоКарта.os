#Использовать fluent
#Использовать lambdas

#Использовать "../../../internal"

Перем ВнутренняяКарта; // Ссылка на внутреннюю карту

// Возвращает итератор множества
//
// Итератор обходит снимок ключей внутренней карты, сформированный в момент его создания,
//  и поддерживает удаление элементов. Изменение множества в обход итератора
//  делает ранее созданные итераторы невалидными
//
//  Возвращаемое значение:
//   Итератор - Итератор множества
//
Функция Итератор() Экспорт
	
	Рефлектор = Новый Рефлектор;

	Возврат Новый ИтераторКлючСоответствие(
		Рефлектор.ПолучитьСвойство(ВнутренняяКарта, "Соответствие"),
		ВнутренняяКарта
	);

КонецФункции

// Выполняет переданный алгоритм для каждого элемента множества
//
// Обход выполняется через итератор множества, изменение множества внутри алгоритма
//  приведёт к исключению
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    Множество.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
//    Множество.ДляКаждого("Элемент -> Массив.Добавить(Элемент)", Новый Структура("Массив", Новый Массив));
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	Итератор().ДляКаждогоОставшегося(Алгоритм, Контекст);
КонецПроцедуры

// Проверяет содержится ли указанный элемент в множестве
//
// Проверка выполняется поиском ключа внутренней карты за постоянное время
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт
	Возврат ВнутренняяКарта.СодержитКлюч(Элемент);
КонецФункции

// Проверяет что множество содержит все элементы переданной коллекции
//
// Проверка выполняется по множеству ключей внутренней карты
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт
	Возврат ВнутренняяКарта.Ключи().СодержитВсе(Коллекция);
КонецФункции

// Проверяет что множество пустое
//
//  Возвращаемое значение:
//   Булево - Истина, если множество пусто
//
Функция Пусто() Экспорт
	Возврат ВнутренняяКарта.Пусто();
КонецФункции

// Возвращает процессор коллекции по элементам множества
//
// Процессор создаётся по копии элементов множества, поэтому дальнейшие изменения множества
//  в процессоре не отражаются
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ВнутренняяКарта.Ключи().ПроцессорКоллекции();
КонецФункции

// Возвращает количество элементов множества
//
//  Возвращаемое значение:
//   Число - Количество элементов множества
//
Функция Количество() Экспорт
	Возврат ВнутренняяКарта.Количество();
КонецФункции

// Выгружает элементы множества в массив
//
// Порядок элементов в массиве соответствует порядку обхода множества
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов множества
//
Функция ВМассив() Экспорт
	Возврат ВнутренняяКарта.Ключи().ВМассив();
КонецФункции

// Добавляет элемент в множество
//
// Если элемент уже содержится в множестве, множество не изменяется.
// Вызывает исключение при попытке добавить Неопределено
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент добавлен, Ложь если он уже содержался в множестве
//
Функция Добавить(Элемент) Экспорт
	Возврат ВнутренняяКарта.Вставить(Элемент, Истина).Пустой();
КонецФункции

// Добавляет в множество все элементы из переданной коллекции
//
// Элементы, которые уже содержатся в множестве, пропускаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	БылДобавленХотяБыОдинЭлемент = Ложь;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		БылДобавленХотяБыОдинЭлемент = Добавить(Итератор.Следующий())
			Или БылДобавленХотяБыОдинЭлемент;

	КонецЦикла;

	Возврат БылДобавленХотяБыОдинЭлемент;

КонецФункции

// Удаляет все элементы множества
//
Процедура Очистить() Экспорт
	ВнутренняяКарта.Очистить();
КонецПроцедуры

// Удаляет переданный элемент из множества
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён, Ложь если множество его не содержало
//
Функция Удалить(Элемент) Экспорт
	
	Возврат ВнутренняяКарта.Удалить(Элемент).СодержитЗначение();

КонецФункции

// Удаляет из множества все элементы которые содержатся в переданной коллекции
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Коллекция.Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		БылУдаленХотяБыОдинЭлемент = Удалить(Итератор.Следующий())
			Или БылУдаленХотяБыОдинЭлемент;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет элементы множества для которых функция предикат вернёт Истина
//
// Удаление выполняется за один проход через итератор множества
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    Множество.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    Множество.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Знач Предикат, Знач Контекст = Неопределено) Экспорт

	Если Пусто() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Предикат) = Тип("Строка") Тогда

		Предикат = Лямбда.Выражение(Предикат)
			.Интерфейс(ФункциональныеИнтерфейсы.УниФункция());

		Если ТипЗнч(Контекст) = Тип("Структура")
            Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
			Предикат.Контекст(Контекст);
		Иначе
			Предикат.ЗахватитьОбъект(Контекст);
		КонецЕсли;

		Предикат = Предикат.ВДействие();

	КонецЕсли;

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Предикат.Выполнить(Итератор.Следующий()) Тогда
			
			Итератор.Удалить();

			БылУдаленХотяБыОдинЭлемент = Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

// Удаляет из множества все элементы которые не содержатся в переданной коллекции
//
// Для каждого элемента множества выполняется проверка вхождения в переданную коллекцию,
//  поэтому сложность операции определяется реализацией переданной коллекции
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	БылУдаленХотяБыОдинЭлемент = Ложь;

	Итератор = Итератор();

	Пока Итератор.ЕстьСледующий() Цикл

		Если Не Коллекция.Содержит(Итератор.Следующий()) Тогда
			
			Итератор.Удалить();

			БылУдаленХотяБыОдинЭлемент = Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат БылУдаленХотяБыОдинЭлемент;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Множество, реализованное на базе карты
//
// Элементы множества хранятся как ключи внутренней карты, поэтому проверка вхождения,
//  добавление и удаление элемента выполняются за постоянное время.
// В отличие от `МножествоСоответствие`, все операции проходят через карту, что немного дороже,
//  но позволяет опираться на её гарантии - в частности, множество не может содержать
//  Неопределено в качестве элемента.
// Порядок обхода определяется порядком ключей внутренней карты
//  и не обязан совпадать с порядком добавления.
// Множество не является потокобезопасным, для одновременной работы из нескольких потоков
//  следует использовать `СинхронизированноеМножество`
//
// Конструктор объекта
//
// Элементы переданной коллекции копируются в множество, дубликаты отбрасываются,
//  дальнейшие изменения переданной коллекции в множестве не отражаются
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементами которой будет заполнено множество
//
// Пример:
//    Множество = Новый МножествоКарта();
//
//    Множество = Новый МножествоКарта(Список);
//
&Обходимое
&Реализует("Множество")
Процедура ПриСозданииОбъекта(Коллекция = Неопределено)
	
	ВнутренняяКарта = Новый КартаСоответствие();

	Если Коллекция <> Неопределено Тогда
		ДобавитьВсе(Коллекция);
	КонецЕсли;

КонецПроцедуры
