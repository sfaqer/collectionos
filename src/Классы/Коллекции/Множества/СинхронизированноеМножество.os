#Использовать "../../../internal"

Перем ВнутреннееМножество;  // Оригинальная коллекция
Перем Блокировка;           // Блокировка для синхронизации доступа

// Возвращает итератор обёрнутого множества
//
// Итератор не захватывает блокировку, поэтому обход требует внешней синхронизации,
//  изменение множества из другого потока во время обхода приводит к исключению
//
//  Возвращаемое значение:
//   Итератор - Итератор множества
//
Функция Итератор() Экспорт
	Возврат ВнутреннееМножество.Итератор();
КонецФункции

// Выполняет переданный алгоритм для каждого элемента множества
//
// Блокировка удерживается на протяжении всего обхода, поэтому длительный алгоритм
//  блокирует остальные потоки
//
// Параметры:
//   Алгоритм - Действие - Делегат на процедуру с одним параметром, в который
//    будет передан элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который
//    будет передан элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
// Пример:
//    множество.ДляКаждого("Элемент -> Сообщить(Элемент)");
//
Процедура ДляКаждого(Алгоритм, Контекст = Неопределено) Экспорт
	
	Блокировка.Заблокировать();

	Попытка
		ВнутреннееМножество.ДляКаждого(Алгоритм, Контекст);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Проверяет содержится ли указанный элемент в множестве
//
// Параметры:
//   Элемент - Произвольный - Проверяемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит указанный элемент
//
Функция Содержит(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.Содержит(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Проверяет что множество содержит все элементы переданной коллекции
//
// Проверка выполняется целиком под блокировкой
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой проверяются на вхождение
//
//  Возвращаемое значение:
//   Булево - Истина, если множество содержит все элементы переданной коллекции
//
Функция СодержитВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.СодержитВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Проверяет что множество пустое
//
//  Возвращаемое значение:
//   Булево - Истина, если множество пусто
//
Функция Пусто() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.Пусто();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;
	
КонецФункции

// Возвращает процессор коллекции по элементам обёрнутой множества
//
// В отличие от остальных методов, вызов выполняется без блокировки
//
//  Возвращаемое значение:
//   ПроцессорКоллекций - Процессор коллекции
//
Функция ПроцессорКоллекции() Экспорт
	Возврат ВнутреннееМножество.ПроцессорКоллекции();
КонецФункции

// Возвращает количество элементов множества
//
//  Возвращаемое значение:
//   Число - Количество элементов множества
//
Функция Количество() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Выгружает элементы множества в массив
//
// Выгрузка выполняется под блокировкой, поэтому полученный массив является
//  согласованным снимком множества
//
//  Возвращаемое значение:
//   Массив из Произвольный - Массив элементов множества
//
Функция ВМассив() Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.ВМассив();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Добавляет элемент в множество
//
// Если элемент уже содержится в множестве, множество не изменяется
//
// Параметры:
//   Элемент - Произвольный - Добавляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент добавлен, Ложь если он уже содержался в множестве
//
Функция Добавить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.Добавить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Добавляет все элементы из переданной коллекции
//
// Элементы добавляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой требуется добавить
//
//  Возвращаемое значение:
//   Булево - Истина, если был добавлен хотя бы один элемент
//
Функция ДобавитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.ДобавитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы множества
//
Процедура Очистить() Экспорт

	Блокировка.Заблокировать();

	Попытка
		ВнутреннееМножество.Очистить();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

КонецПроцедуры

// Удаляет переданный элемент из множества
//
// Параметры:
//   Элемент - Произвольный - Удаляемый элемент
//
//  Возвращаемое значение:
//   Булево - Истина, если элемент был удалён
//
Функция Удалить(Элемент) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.Удалить(Элемент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы которые содержатся в переданной коллекции
//
// Элементы удаляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут удалены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция УдалитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.УдалитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет элементы для которых функция предикат вернёт Истина
//
// Блокировка удерживается на протяжении всего удаления, поэтому длительный предикат
//  блокирует остальные потоки
//
// Параметры:
//   Предикат - Действие - Делегат на функцию с одним параметром, в которую передаётся элемент множества
//            - Строка - Лямбда выражение с одним параметром, в который передаётся элемент множества
//   Контекст - Структура - Контекст добавляемый в лямбда выражение, значения будут доступны по обращению
//    к ключу как к переменной.
//    При передачи действия в первом параметре, этот параметр игнорируется
//            - Сценарий - Экземпляр объекта, который будет захвачен в лямбда выражение, в лямбда выражении
//    будет доступен контекст (публичные и приватные поля, публичные методы) объекта.
//    При передачи действия в первом параметре, этот параметр игнорируется
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
// Пример:
//    множество.УдалитьЕсли("(Элемент) -> Элемент >= 2");
//
//    множество.УдалитьЕсли("(Элемент) -> Элемент >= Предел", Новый Структура("Предел", 2));
//
Функция УдалитьЕсли(Предикат, Контекст = Неопределено) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.УдалитьЕсли(Предикат, Контекст);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Удаляет все элементы которые не содержатся в переданной коллекции
//
// Элементы удаляются под общей блокировкой, то есть атомарно относительно других потоков
//
// Параметры:
//   Коллекция - ЧитаемаяКоллекция - Коллекция, элементы которой будут сохранены
//
//  Возвращаемое значение:
//   Булево - Истина, если был удалён хотя бы один элемент
//
Функция СохранитьВсе(Коллекция) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Результат = ВнутреннееМножество.СохранитьВсе(Коллекция);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	КоллекцииСлужебный.ОбработчикПолученияПредставленияКоллекции(ЭтотОбъект, Представление, СтандартнаяОбработка);
КонецПроцедуры

Функция ПолучитьИтератор() // BSLLS:UnusedLocalMethod-off
	Возврат Новый СлужебныйИтераторДляДвижка(Итератор());
КонецФункции

// Потокобезопасное представление множества
//
// Оборачивает переданное множество и выполняет каждый его метод под блокировкой,
//  поэтому отдельный вызов метода атомарен относительно других потоков.
// Обёрнутое множество не копируется, поэтому изменения, выполненные напрямую через него,
//  видны в представлении, но защиту блокировкой уже не получают - работать
//  с множеством следует только через представление.
// Обход итератором не синхронизирован, последовательность операций
//  (например проверка и добавление) тоже не атомарна, такие сценарии требуют
//  внешней синхронизации по представлению
//
// Конструктор объекта
//
// Переданное множество не копируется, представление работает поверх него
//
// Параметры:
//   Множество - Множество - Оборачиваемое множество
//
// Пример:
//    Множество = Новый СинхронизированноеМножество(Новый МножествоСоответствие());
//
&Обходимое
&Реализует("Множество")
Процедура ПриСозданииОбъекта(Множество)
	
	ВнутреннееМножество  = Множество;
	Блокировка           = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
